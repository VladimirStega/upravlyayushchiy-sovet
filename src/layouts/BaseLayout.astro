---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import CouncilNetwork from "../components/CouncilNetwork.astro";

interface Props {
  title: string;
  description?: string;
  current?: string;
  pageClass?: string;
}

const {
  title,
  description = "Официальный сайт Управляющего совета образовательной организации",
  pageClass = ""
} = Astro.props;

const navigation = [
  ["Главная", "/"],
  ["О совете", "/o-sovete/"],
  ["Состав", "/sostav/"],
  ["Документы", "/dokumenty/"],
  ["Новости", "/novosti/"],
  ["Видео", "/video/"]
];

const activityNavigation = [
  ["Решения и заседания", "/deyatelnost/resheniya/"],
  ["Проекты", "/deyatelnost/proekty/"],
  ["Опросы", "/deyatelnost/oprosy/"]
];

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sitePath = (href: string) => href === "/" ? `${base}/` : `${base}${href}`;
const path = Astro.url.pathname.replace(base, "") || "/";
const isActive = (href: string) => {
  if (href === "/" || href === "/deyatelnost/") return path === href;
  return path.startsWith(href);
};
const activityActive = path.startsWith("/deyatelnost/");
const isHomeNetwork = pageClass.includes("home-network-page");
const networkMode = isHomeNetwork
  ? "home"
  : path.startsWith("/sostav") || path.startsWith("/o-sovete")
    ? "people"
  : path.startsWith("/deyatelnost")
    ? "process"
    : path.startsWith("/novosti")
      ? "news"
      : path.startsWith("/dokumenty") || path.startsWith("/arhiv") || path.startsWith("/komplektator")
        ? "documents"
        : path.startsWith("/video") || path.startsWith("/dostizheniya")
          ? "media"
          : "standard";
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#174a8b" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body class:list={[pageClass, { "network-page": !isHomeNetwork }]}>
    <a class="skip-link" href="#main">Перейти к содержанию</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={sitePath("/")} aria-label="На главную">
          <span class="brand-mark"><i></i><i></i><i></i></span>
          <span class="brand-text">
            <strong>Управляющий совет</strong>
            <small>МБОУ СОШ № 47 г. Липецка</small>
          </span>
        </a>
        <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
          <span></span><span></span><span></span><span class="sr-only">Открыть меню</span>
        </button>
        <nav class="main-nav" id="main-nav" aria-label="Основная навигация">
          {navigation.slice(0, 3).map(([label, href]) => (
            <a href={sitePath(href)} class:list={{ active: isActive(href) }} aria-current={isActive(href) ? "page" : undefined}>{label}</a>
          ))}
          <details class="nav-more">
            <summary class:list={{ active: activityActive }}>Деятельность <span aria-hidden="true">⌄</span></summary>
            <div class="nav-submenu">
              {activityNavigation.map(([label, href]) => (
                <a href={sitePath(href)} class:list={{ active: isActive(href) }} aria-current={isActive(href) ? "page" : undefined}>{label}</a>
              ))}
            </div>
          </details>
          {navigation.slice(3).map(([label, href]) => (
            <a href={sitePath(href)} class:list={{ active: isActive(href) }} aria-current={isActive(href) ? "page" : undefined}>{label}</a>
          ))}
          <div class="nav-utility-actions">
            <button class="nav-utility-button" id="accessibility-toggle" type="button" aria-expanded="false" aria-controls="accessibility-panel">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18V3Z"/><circle cx="12" cy="12" r="9"/></svg>
              <span>Для слабовидящих</span>
            </button>
            <a class="nav-contact-link" href="#contacts">Связаться</a>
          </div>
        </nav>
      </div>
    </header>
    <aside class="accessibility-panel" id="accessibility-panel" aria-label="Настройки версии для слабовидящих" hidden>
      <div class="container accessibility-panel-inner">
        <fieldset>
          <legend>Размер текста</legend>
          <div class="accessibility-options" role="group">
            <button type="button" data-font="normal" class="is-selected">А</button>
            <button type="button" data-font="large">А+</button>
            <button type="button" data-font="extra">А++</button>
          </div>
        </fieldset>
        <label><input type="checkbox" id="accessibility-contrast" /> Высокий контраст</label>
        <label><input type="checkbox" id="accessibility-spacing" /> Увеличить интервалы</label>
        <label><input type="checkbox" id="accessibility-images" /> Скрыть изображения</label>
        <button class="accessibility-reset" id="accessibility-reset" type="button">Сбросить настройки</button>
      </div>
    </aside>
    <main id="main">
      <CouncilNetwork mode={networkMode} />
      <slot />
    </main>
    <footer id="contacts" class="site-footer">
      <div class="container footer-grid">
        <div>
          <a class="brand brand-footer" href={sitePath("/")}>
            <span class="brand-mark"><i></i><i></i><i></i></span>
            <span class="brand-text"><strong>Управляющий совет</strong><small>Открытость · Диалог · Результат</small></span>
          </a>
          <p>Информационный ресурс Управляющего совета МБОУ СОШ № 47 г. Липецка.</p>
        </div>
        <div>
          <h2>Контакты</h2>
          <ul>
            <li><span>Телефон совета</span><strong>+7 (4742) 34-05-72</strong></li>
            <li><span>Электронная почта</span><strong>sc47lip@schools48.ru</strong></li>
            <li><span>Адрес</span><strong>г. Липецк, ул. Космонавтов, д. 11Б</strong></li>
          </ul>
        </div>
        <div>
          <h2>Приём обращений</h2>
          <p>Вопрос или предложение для Управляющего совета можно направить через электронную почту школы.</p>
          <a class="button button-light" href={sitePath("/kontakty/")}>Задать вопрос</a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© 2026 Управляющий совет</span>
        <span>Дата последнего обновления: <strong>30 августа 2026 года</strong></span>
      </div>
    </footer>

    <script>
      if (!document.documentElement.dataset.pageScrollReset) {
        document.documentElement.dataset.pageScrollReset = "true";
        document.addEventListener("astro:page-load", () => {
          if (!window.location.hash) window.scrollTo(0, 0);
        });
      }

      const storageKey = "governing-council-accessibility";
      const defaultSettings = { font: "normal", contrast: false, spacing: false, images: false };

      const closeMobileMenu = () => {
        const toggle = document.querySelector("#menu-toggle");
        const nav = document.querySelector("#main-nav");
        toggle?.setAttribute("aria-expanded", "false");
        nav?.classList.remove("open");
        document.body.classList.remove("menu-open");
      };

      const initializeLayout = () => {
        const toggle = document.querySelector("#menu-toggle");
        const nav = document.querySelector("#main-nav");

        if (toggle instanceof HTMLElement && nav instanceof HTMLElement && !toggle.dataset.bound) {
          toggle.dataset.bound = "true";
          toggle.addEventListener("click", () => {
            const opening = toggle.getAttribute("aria-expanded") !== "true";
            toggle.setAttribute("aria-expanded", String(opening));
            nav.classList.toggle("open", opening);
            document.body.classList.toggle("menu-open", opening);
          });

          nav.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMobileMenu));
        }

        const accessibilityToggle = document.querySelector("#accessibility-toggle");
        const accessibilityPanel = document.querySelector("#accessibility-panel");
        const contrastInput = document.querySelector("#accessibility-contrast");
        const spacingInput = document.querySelector("#accessibility-spacing");
        const imagesInput = document.querySelector("#accessibility-images");
        const resetButton = document.querySelector("#accessibility-reset");
        const fontButtons = document.querySelectorAll("[data-font]");
        let settings = { ...defaultSettings };

        try {
          settings = { ...settings, ...JSON.parse(localStorage.getItem(storageKey) || "{}") };
        } catch {
          settings = { ...defaultSettings };
        }

        const applyAccessibility = () => {
          const root = document.documentElement;
          root.classList.toggle("a11y-on", settings.font !== "normal" || settings.contrast || settings.spacing || settings.images);
          root.classList.toggle("a11y-font-large", settings.font === "large");
          root.classList.toggle("a11y-font-extra", settings.font === "extra");
          root.classList.toggle("a11y-contrast", settings.contrast);
          root.classList.toggle("a11y-spacing", settings.spacing);
          root.classList.toggle("a11y-images-hidden", settings.images);

          if (contrastInput instanceof HTMLInputElement) contrastInput.checked = settings.contrast;
          if (spacingInput instanceof HTMLInputElement) spacingInput.checked = settings.spacing;
          if (imagesInput instanceof HTMLInputElement) imagesInput.checked = settings.images;
          fontButtons.forEach((button) => {
            button.classList.toggle("is-selected", button.getAttribute("data-font") === settings.font);
            button.setAttribute("aria-pressed", String(button.getAttribute("data-font") === settings.font));
          });
          localStorage.setItem(storageKey, JSON.stringify(settings));
        };

        applyAccessibility();

        if (accessibilityToggle instanceof HTMLElement && accessibilityPanel instanceof HTMLElement && !accessibilityToggle.dataset.bound) {
          accessibilityToggle.dataset.bound = "true";
          accessibilityToggle.addEventListener("click", () => {
            const opening = accessibilityPanel.hidden;
            accessibilityPanel.hidden = !opening;
            accessibilityToggle.setAttribute("aria-expanded", String(opening));
          });
        }

        fontButtons.forEach((button) => {
          if (!(button instanceof HTMLElement) || button.dataset.bound) return;
          button.dataset.bound = "true";
          button.addEventListener("click", () => {
            settings.font = button.getAttribute("data-font") || "normal";
            applyAccessibility();
          });
        });

        if (contrastInput instanceof HTMLInputElement && !contrastInput.dataset.bound) {
          contrastInput.dataset.bound = "true";
          contrastInput.addEventListener("change", () => { settings.contrast = contrastInput.checked; applyAccessibility(); });
        }
        if (spacingInput instanceof HTMLInputElement && !spacingInput.dataset.bound) {
          spacingInput.dataset.bound = "true";
          spacingInput.addEventListener("change", () => { settings.spacing = spacingInput.checked; applyAccessibility(); });
        }
        if (imagesInput instanceof HTMLInputElement && !imagesInput.dataset.bound) {
          imagesInput.dataset.bound = "true";
          imagesInput.addEventListener("change", () => { settings.images = imagesInput.checked; applyAccessibility(); });
        }
        if (resetButton instanceof HTMLElement && !resetButton.dataset.bound) {
          resetButton.dataset.bound = "true";
          resetButton.addEventListener("click", () => { settings = { ...defaultSettings }; applyAccessibility(); });
        }
      };

      if (!document.documentElement.dataset.layoutEvents) {
        document.documentElement.dataset.layoutEvents = "true";
        document.addEventListener("astro:page-load", initializeLayout);
        document.addEventListener("keydown", (event) => {
          if (event.key !== "Escape") return;
          closeMobileMenu();
          const panel = document.querySelector("#accessibility-panel");
          const panelToggle = document.querySelector("#accessibility-toggle");
          if (panel instanceof HTMLElement) panel.hidden = true;
          panelToggle?.setAttribute("aria-expanded", "false");
        });
        window.addEventListener("resize", () => {
          if (window.innerWidth > 820) closeMobileMenu();
        }, { passive: true });
      }

      initializeLayout();
    </script>
  </body>
</html>
