---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  current?: string;
}

const {
  title,
  description = "Официальный сайт Управляющего совета образовательной организации",
  current = ""
} = Astro.props;

const navigation = [
  ["О совете", "/#about"],
  ["Состав", "/#people"],
  ["Решения", "/#decisions"],
  ["Проекты", "/#projects"],
  ["Документы", "/#documents"],
  ["Новости", "/#news"],
  ["Комплектатор", "/komplektator/"]
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#123e52" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержанию</a>
    <div class="topline">
      <div class="container topline-inner">
        <span>Официальный сайт Управляющего совета</span>
        <div class="topline-actions">
          <button class="text-button" id="contrast-toggle" type="button" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18V3Z"/><circle cx="12" cy="12" r="9"/></svg>
            Версия для слабовидящих
          </button>
          <a href="#contacts">Связаться с советом</a>
        </div>
      </div>
    </div>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="На главную">
          <span class="brand-mark"><i></i><i></i><i></i></span>
          <span class="brand-text">
            <strong>Управляющий совет</strong>
            <small>Наименование образовательной организации</small>
          </span>
        </a>
        <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
          <span></span><span></span><span></span><span class="sr-only">Открыть меню</span>
        </button>
        <nav class="main-nav" id="main-nav" aria-label="Основная навигация">
          {navigation.map(([label, href]) => (
            <a href={href} class:list={{ active: current === label }}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer id="contacts" class="site-footer">
      <div class="container footer-grid">
        <div>
          <a class="brand brand-footer" href="/">
            <span class="brand-mark"><i></i><i></i><i></i></span>
            <span class="brand-text"><strong>Управляющий совет</strong><small>Открытость · Диалог · Результат</small></span>
          </a>
          <p>Официальный информационный ресурс Управляющего совета образовательной организации.</p>
        </div>
        <div>
          <h2>Контакты</h2>
          <ul>
            <li><span>Телефон</span><strong>+7 (___) ___-__-__</strong></li>
            <li><span>Электронная почта</span><strong>совет@example.ru</strong></li>
            <li><span>Адрес</span><strong>Адрес образовательной организации</strong></li>
          </ul>
        </div>
        <div>
          <h2>Приём обращений</h2>
          <p>Здесь будет ссылка на форму обращения в Управляющий совет и правила обработки персональных данных.</p>
          <a class="button button-light" href="#">Задать вопрос</a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© 2026 Управляющий совет</span>
        <span>Дата последнего обновления: <strong>указать дату</strong></span>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector("#menu-toggle");
      const nav = document.querySelector("#main-nav");
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!open));
        nav?.classList.toggle("open", !open);
      });

      nav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          toggle?.setAttribute("aria-expanded", "false");
          nav.classList.remove("open");
        });
      });

      const contrast = document.querySelector("#contrast-toggle");
      contrast?.addEventListener("click", () => {
        const enabled = document.documentElement.classList.toggle("high-contrast");
        contrast.setAttribute("aria-pressed", String(enabled));
      });
    </script>
  </body>
</html>
