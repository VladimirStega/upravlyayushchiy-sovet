---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  current?: string;
  pageClass?: string;
}

const {
  title,
  description = "Официальный сайт Управляющего совета образовательной организации",
  pageClass = ""
} = Astro.props;

const navigation = [
  ["Главная", "/"],
  ["О совете", "/o-sovete/"],
  ["Состав", "/sostav/"],
  ["Документы", "/dokumenty/"],
  ["Новости", "/novosti/"],
  ["Видео", "/video/"]
];

const activityNavigation = [
  ["Обзор деятельности", "/deyatelnost/"],
  ["Решения и заседания", "/deyatelnost/resheniya/"],
  ["Проекты", "/deyatelnost/proekty/"],
  ["Опросы", "/deyatelnost/oprosy/"],
  ["Цифровая практика", "/deyatelnost/cifrovaya-praktika/"]
];

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sitePath = (href: string) => href === "/" ? `${base}/` : `${base}${href}`;
const path = Astro.url.pathname.replace(base, "") || "/";
const isActive = (href: string) => {
  if (href === "/" || href === "/deyatelnost/") return path === href;
  return path.startsWith(href);
};
const activityActive = path.startsWith("/deyatelnost/");
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#174a8b" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main">Перейти к содержанию</a>
    <div class="topline">
      <div class="container topline-inner">
        <div class="topline-actions">
          <button class="text-button" id="accessibility-toggle" type="button" aria-expanded="false" aria-controls="accessibility-panel">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18V3Z"/><circle cx="12" cy="12" r="9"/></svg>
            Версия для слабовидящих
          </button>
          <a href="#contacts">Связаться с советом</a>
        </div>
      </div>
    </div>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={sitePath("/")} aria-label="На главную">
          <span class="brand-mark"><i></i><i></i><i></i></span>
          <span class="brand-text">
            <strong>Управляющий совет</strong>
            <small>Наименование образовательной организации</small>
          </span>
        </a>
        <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
          <span></span><span></span><span></span><span class="sr-only">Открыть меню</span>
        </button>
        <nav class="main-nav" id="main-nav" aria-label="Основная навигация">
          {navigation.slice(0, 3).map(([label, href]) => (
            <a href={sitePath(href)} class:list={{ active: isActive(href) }} aria-current={isActive(href) ? "page" : undefined}>{label}</a>
          ))}
          <details class="nav-more">
            <summary class:list={{ active: activityActive }}>Деятельность <span aria-hidden="true">⌄</span></summary>
            <div class="nav-submenu">
              {activityNavigation.map(([label, href]) => (
                <a href={sitePath(href)} class:list={{ active: isActive(href) }} aria-current={isActive(href) ? "page" : undefined}>{label}</a>
              ))}
            </div>
          </details>
          {navigation.slice(3).map(([label, href]) => (
            <a href={sitePath(href)} class:list={{ active: isActive(href) }} aria-current={isActive(href) ? "page" : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <aside class="accessibility-panel" id="accessibility-panel" aria-label="Настройки версии для слабовидящих" hidden>
      <div class="container accessibility-panel-inner">
        <fieldset>
          <legend>Размер текста</legend>
          <div class="accessibility-options" role="group">
            <button type="button" data-font="normal" class="is-selected">А</button>
            <button type="button" data-font="large">А+</button>
            <button type="button" data-font="extra">А++</button>
          </div>
        </fieldset>
        <label><input type="checkbox" id="accessibility-contrast" /> Высокий контраст</label>
        <label><input type="checkbox" id="accessibility-spacing" /> Увеличить интервалы</label>
        <label><input type="checkbox" id="accessibility-images" /> Скрыть изображения</label>
        <button class="accessibility-reset" id="accessibility-reset" type="button">Сбросить настройки</button>
      </div>
    </aside>
    <main id="main">
      <slot />
    </main>
    <footer id="contacts" class="site-footer">
      <div class="container footer-grid">
        <div>
          <a class="brand brand-footer" href={sitePath("/")}>
            <span class="brand-mark"><i></i><i></i><i></i></span>
            <span class="brand-text"><strong>Управляющий совет</strong><small>Открытость · Диалог · Результат</small></span>
          </a>
          <p>Официальный информационный ресурс Управляющего совета образовательной организации.</p>
        </div>
        <div>
          <h2>Контакты</h2>
          <ul>
            <li><span>Телефон</span><strong>+7 (___) ___-__-__</strong></li>
            <li><span>Электронная почта</span><strong>совет@example.ru</strong></li>
            <li><span>Адрес</span><strong>Адрес образовательной организации</strong></li>
          </ul>
        </div>
        <div>
          <h2>Приём обращений</h2>
          <p>Здесь будет ссылка на форму обращения в Управляющий совет и правила обработки персональных данных.</p>
          <a class="button button-light" href="#">Задать вопрос</a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© 2026 Управляющий совет</span>
        <span>Дата последнего обновления: <strong>указать дату</strong></span>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector("#menu-toggle");
      const nav = document.querySelector("#main-nav");
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!open));
        nav?.classList.toggle("open", !open);
      });

      nav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          toggle?.setAttribute("aria-expanded", "false");
          nav.classList.remove("open");
        });
      });

      const accessibilityToggle = document.querySelector("#accessibility-toggle");
      const accessibilityPanel = document.querySelector("#accessibility-panel");
      const contrastInput = document.querySelector("#accessibility-contrast");
      const spacingInput = document.querySelector("#accessibility-spacing");
      const imagesInput = document.querySelector("#accessibility-images");
      const resetButton = document.querySelector("#accessibility-reset");
      const fontButtons = document.querySelectorAll("[data-font]");
      const storageKey = "governing-council-accessibility";

      const defaultSettings = { font: "normal", contrast: false, spacing: false, images: false };
      let settings = { ...defaultSettings };

      try {
        settings = { ...settings, ...JSON.parse(localStorage.getItem(storageKey) || "{}") };
      } catch {
        settings = { ...defaultSettings };
      }

      const applyAccessibility = () => {
        const root = document.documentElement;
        root.classList.toggle("a11y-on", settings.font !== "normal" || settings.contrast || settings.spacing || settings.images);
        root.classList.toggle("a11y-font-large", settings.font === "large");
        root.classList.toggle("a11y-font-extra", settings.font === "extra");
        root.classList.toggle("a11y-contrast", settings.contrast);
        root.classList.toggle("a11y-spacing", settings.spacing);
        root.classList.toggle("a11y-images-hidden", settings.images);

        if (contrastInput instanceof HTMLInputElement) contrastInput.checked = settings.contrast;
        if (spacingInput instanceof HTMLInputElement) spacingInput.checked = settings.spacing;
        if (imagesInput instanceof HTMLInputElement) imagesInput.checked = settings.images;
        fontButtons.forEach((button) => {
          button.classList.toggle("is-selected", button.getAttribute("data-font") === settings.font);
          button.setAttribute("aria-pressed", String(button.getAttribute("data-font") === settings.font));
        });
        localStorage.setItem(storageKey, JSON.stringify(settings));
      };

      applyAccessibility();

      accessibilityToggle?.addEventListener("click", () => {
        if (!(accessibilityPanel instanceof HTMLElement)) return;
        const opening = accessibilityPanel.hidden;
        accessibilityPanel.hidden = !opening;
        accessibilityToggle.setAttribute("aria-expanded", String(opening));
      });

      fontButtons.forEach((button) => button.addEventListener("click", () => {
        settings.font = button.getAttribute("data-font") || "normal";
        applyAccessibility();
      }));
      contrastInput?.addEventListener("change", () => {
        settings.contrast = contrastInput instanceof HTMLInputElement && contrastInput.checked;
        applyAccessibility();
      });
      spacingInput?.addEventListener("change", () => {
        settings.spacing = spacingInput instanceof HTMLInputElement && spacingInput.checked;
        applyAccessibility();
      });
      imagesInput?.addEventListener("change", () => {
        settings.images = imagesInput instanceof HTMLInputElement && imagesInput.checked;
        applyAccessibility();
      });
      resetButton?.addEventListener("click", () => {
        settings = { ...defaultSettings };
        applyAccessibility();
      });
    </script>
  </body>
</html>
