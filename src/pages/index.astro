---
import BaseLayout from "../layouts/BaseLayout.astro";
import { currentNews } from "../data/news";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sitePath = (href: string) => `${base}${href}`;
---

<BaseLayout
  title="Управляющий совет — решения, которые меняют школу"
  description="Решения и новости Управляющего совета образовательной организации."
  pageClass="home-network-page"
>
  <canvas class="home-network-canvas" id="home-network-canvas" aria-hidden="true"></canvas>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <p class="eyebrow"><span></span> Управляющий совет</p>
        <h1>Решения, которые <em>меняют школу</em></h1>
        <p class="hero-lead">
          Объединяем учеников, родителей, педагогов и партнёров, чтобы вместе создавать
          открытую, безопасную и современную образовательную среду.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={sitePath("/o-sovete/")}>Узнать о совете</a>
          <a class="button button-ghost" href={sitePath("/kontakty/")}>Предложить инициативу</a>
        </div>
      </div>

      <div class="hero-visual hero-video-visual">
        <div class="photo-placeholder photo-placeholder-main hero-video-main">
          <a class="video-play-link" href={sitePath("/video/")} aria-label="Перейти к видеоматериалам">▶</a>
          <strong>Презентационный ролик</strong>
          <small>Видео об Управляющем совете · до 5 минут · 16:9</small>
        </div>
      </div>
    </div>
  </section>

  <section class="section impact-section" id="about">
    <div class="container">
      <div class="section-heading heading-split">
        <div>
          <p class="eyebrow eyebrow-dark"><span></span> Совет в действии</p>
          <h2>Открыто говорим.<br /><em>Вместе решаем.</em></h2>
        </div>
        <p>
          Здесь появится краткое описание миссии и полномочий Управляющего совета.
          Текст должен объяснять, какие вопросы решает совет и как жители школьного
          сообщества могут участвовать в его работе.
        </p>
      </div>
      <div class="stats-grid">
        <article><span class="stat-value">12</span><strong>членов совета</strong><p>Утверждённый состав на 2025–2026 учебный год</p></article>
        <article><span class="stat-value">__</span><strong>заседаний за год</strong><p>Здесь будет подтверждённое число проведённых заседаний</p></article>
        <article class="stat-accent"><span class="stat-value">__</span><strong>реализованных проектов</strong><p>Количество инициатив с измеримым результатом</p></article>
        <article><span class="stat-value">__</span><strong>участников опросов</strong><p>Обучающиеся, родители и работники образовательной организации</p></article>
      </div>
    </div>
  </section>

  <section class="section decisions-section" id="decisions">
    <div class="container decisions-grid">
      <div>
        <p class="eyebrow eyebrow-light"><span></span> От предложения к результату</p>
        <h2>Каждое решение<br /><em>можно проверить</em></h2>
        <p class="section-lead">
          Здесь показываем путь от предложения до исполненного решения. Полный архив
          решений и протоколов размещён на отдельной странице.
        </p>
        <a class="button button-light" href={sitePath("/deyatelnost/resheniya/")}>Все решения</a>
      </div>
      <div class="decision-list">
        <article>
          <div class="decision-top"><span class="status-chip status-progress"><i></i> В работе</span><time>Указать дату</time></div>
          <h3>Здесь будет название актуального решения Управляющего совета</h3>
          <div class="progress"><span style="width: 62%"></span></div>
          <p>Ответственный: <strong>указать комиссию или участника</strong></p>
        </article>
        <article>
          <div class="decision-top"><span class="status-chip status-done"><i></i> Выполнено</span><time>Указать дату</time></div>
          <h3>Здесь будет название выполненного решения Управляющего совета</h3>
          <div class="progress"><span style="width: 100%"></span></div>
          <p>Результат: <strong>добавить подтверждённый результат</strong></p>
        </article>
      </div>
    </div>
  </section>

  <section class="section news-section" id="news">
    <div class="container">
      <div class="section-heading heading-row">
        <div>
          <p class="eyebrow eyebrow-dark"><span></span> Новости совета</p>
          <h2>Работа совета — <em>в деталях</em></h2>
        </div>
        <a class="text-link" href={sitePath("/novosti/")}>Все новости <span>→</span></a>
      </div>
      <div class="editorial-news-grid">
        {currentNews.slice(0, 3).map((item, index) => (
          <article class:list={["editorial-news-card", { "editorial-news-featured": index === 0 }]}>
            <div class="photo-placeholder editorial-news-image">
              <span class="placeholder-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="m6 37 11-13 8 8 6-7 11 12"/><circle cx="34" cy="14" r="5"/></svg></span>
              <strong>{item.mediaLabel}</strong>
            </div>
            <div>
              <div class="news-card-meta"><span>{item.categoryLabel}</span><time datetime={item.date}>{item.dateLabel}</time></div>
              <h3>{item.title}</h3>
              <p>{item.excerpt}</p>
              <div class="news-card-actions">
                <a href={sitePath(`/novosti/${item.slug}/`)}>Читать новость <span>→</span></a>
                <a class="news-source-link" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">Посмотреть во ВКонтакте</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-inner">
      <div>
        <p class="eyebrow eyebrow-light"><span></span> Есть предложение?</p>
        <h2>Ваш голос помогает<br /><em>принимать решения</em></h2>
      </div>
      <div>
        <p>Здесь будет краткое приглашение направить вопрос, инициативу или предложение в Управляющий совет.</p>
        <a class="button button-coral" href={sitePath("/kontakty/")}>Написать в совет</a>
      </div>
    </div>
  </section>

  <script>
    const setupCouncilNetwork = () => {
      const canvas = document.querySelector("#home-network-canvas");
      if (!(canvas instanceof HTMLCanvasElement)) return;

      const previousController = (window as any).__councilNetworkController as AbortController | undefined;
      previousController?.abort();
      const controller = new AbortController();
      (window as any).__councilNetworkController = controller;

      const context = canvas.getContext("2d");
      if (!context) return;

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let width = 0;
      let height = 0;
      let pixelRatio = 1;
      let animationFrame = 0;
      type NodeKind = "person" | "dialog" | "book" | "document" | "idea" | "result" | "school";
      let nodes: Array<{ x: number; y: number; phase: number; speed: number; radius: number; amplitude: number; emphasis: boolean; kind: NodeKind }> = [];

      const seeded = (seed: number) => {
        const value = Math.sin(seed * 9283.17 + 78.23) * 43758.5453;
        return value - Math.floor(value);
      };

      const createNodes = () => {
        const count = width < 560 ? 9 : width < 900 ? 13 : 18;
        const kinds: NodeKind[] = ["person", "dialog", "book", "document", "idea", "result", "school"];
        const placed: typeof nodes = [];
        for (let index = 0; index < count; index += 1) {
          const radius = (width < 560 ? 13 : 16) + seeded(index * 7 + 3) * (width < 560 ? 9 : 15);
          let x = width * (0.07 + seeded(index * 11 + 5) * 0.86);
          let y = height * (0.08 + seeded(index * 13 + 9) * 0.84);

          for (let attempt = 0; attempt < 24; attempt += 1) {
            const overlaps = placed.some((node) => Math.hypot(node.x - x, node.y - y) < node.radius + radius + 32);
            if (!overlaps) break;
            x = width * (0.06 + seeded(index * 31 + attempt * 17 + 2) * 0.88);
            y = height * (0.07 + seeded(index * 37 + attempt * 19 + 4) * 0.86);
          }

          placed.push({
            x,
            y,
            phase: seeded(index * 17 + 6) * Math.PI * 2,
            speed: 0.72 + seeded(index * 19 + 8) * 0.56,
            radius,
            amplitude: 12 + seeded(index * 23 + 10) * 14,
            emphasis: index % 4 === 0,
            kind: kinds[index % kinds.length]
          });
        }
        nodes = placed;
      };

      const resize = () => {
        width = window.innerWidth;
        height = window.innerHeight;
        pixelRatio = Math.min(window.devicePixelRatio || 1, 1.5);
        canvas.width = Math.round(width * pixelRatio);
        canvas.height = Math.round(height * pixelRatio);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        createNodes();
        if (reducedMotion.matches) draw(0);
      };

      const positionsAt = (time: number) => nodes.map((node) => {
        const driftX = reducedMotion.matches ? 0 : Math.sin(time * 0.00017 * node.speed + node.phase) * node.amplitude;
        const driftY = reducedMotion.matches ? 0 : Math.cos(time * 0.00013 * node.speed + node.phase * 1.37) * node.amplitude * 0.72;
        return {
          ...node,
          drawX: node.x + driftX,
          drawY: node.y + driftY
        };
      });

      const drawNode = (point: ReturnType<typeof positionsAt>[number]) => {
        const { drawX, drawY, radius, emphasis, kind } = point;
        context.save();
        context.translate(drawX, drawY);
        context.shadowColor = "rgba(4, 17, 32, 0.28)";
        context.shadowBlur = emphasis ? 18 : 10;
        context.fillStyle = emphasis ? "rgba(221, 239, 246, 0.3)" : "rgba(218, 232, 241, 0.19)";
        context.strokeStyle = emphasis ? "rgba(8, 25, 43, 0.96)" : "rgba(9, 29, 49, 0.86)";
        context.lineWidth = emphasis ? 1.6 : 1.1;
        context.beginPath();
        context.arc(0, 0, radius, 0, Math.PI * 2);
        context.fill();
        context.stroke();
        context.shadowBlur = 0;

        const scale = radius / 22;
        context.scale(scale, scale);
        context.strokeStyle = "rgba(8, 27, 47, 0.94)";
        context.fillStyle = "rgba(8, 27, 47, 0.9)";
        context.lineWidth = 1.7 / scale;
        context.lineCap = "round";
        context.lineJoin = "round";

        if (kind === "person") {
          context.beginPath();
          context.arc(0, -5, 4, 0, Math.PI * 2);
          context.fill();
          context.beginPath();
          context.moveTo(-9, 10);
          context.quadraticCurveTo(-7, 1, 0, 1);
          context.quadraticCurveTo(7, 1, 9, 10);
          context.closePath();
          context.fill();
        } else if (kind === "dialog") {
          context.beginPath();
          context.roundRect(-11, -8, 22, 15, 4);
          context.moveTo(-3, 7);
          context.lineTo(-7, 12);
          context.lineTo(2, 7);
          context.stroke();
          [-6, 0, 6].forEach((x) => {
            context.beginPath();
            context.arc(x, -1, 1.25, 0, Math.PI * 2);
            context.fill();
          });
        } else if (kind === "book") {
          context.beginPath();
          context.moveTo(0, -8);
          context.quadraticCurveTo(-5, -11, -11, -8);
          context.lineTo(-11, 9);
          context.quadraticCurveTo(-5, 6, 0, 10);
          context.quadraticCurveTo(5, 6, 11, 9);
          context.lineTo(11, -8);
          context.quadraticCurveTo(5, -11, 0, -8);
          context.lineTo(0, 10);
          context.stroke();
        } else if (kind === "document") {
          context.strokeRect(-8, -11, 16, 22);
          [-5, 0, 5].forEach((y, index) => {
            context.beginPath();
            context.moveTo(-4, y);
            context.lineTo(index === 2 ? 3 : 5, y);
            context.stroke();
          });
        } else if (kind === "idea") {
          context.beginPath();
          context.arc(0, -3, 7, Math.PI * 0.15, Math.PI * 0.85, true);
          context.quadraticCurveTo(-5, 3, -3, 6);
          context.lineTo(3, 6);
          context.quadraticCurveTo(5, 3, 6.2, 0);
          context.stroke();
          context.beginPath();
          context.moveTo(-3, 9);
          context.lineTo(3, 9);
          context.moveTo(-1.8, 12);
          context.lineTo(1.8, 12);
          context.stroke();
        } else if (kind === "result") {
          context.beginPath();
          context.arc(0, 0, 11, 0, Math.PI * 2);
          context.moveTo(-5, 0);
          context.lineTo(-1, 5);
          context.lineTo(7, -5);
          context.stroke();
        } else {
          context.beginPath();
          context.moveTo(-11, -3);
          context.lineTo(0, -11);
          context.lineTo(11, -3);
          context.moveTo(-8, -3);
          context.lineTo(-8, 10);
          context.lineTo(8, 10);
          context.lineTo(8, -3);
          context.moveTo(-3, 10);
          context.lineTo(-3, 2);
          context.lineTo(3, 2);
          context.lineTo(3, 10);
          context.stroke();
        }

        if (emphasis) {
          context.scale(1 / scale, 1 / scale);
          context.strokeStyle = "rgba(221, 239, 246, 0.42)";
          context.lineWidth = 1;
          context.beginPath();
          context.arc(0, 0, radius + 6, 0, Math.PI * 2);
          context.stroke();
        }
        context.restore();
      };

      const draw = (time: number) => {
        if (!canvas.isConnected || controller.signal.aborted) return;
        context.clearRect(0, 0, width, height);
        const points = positionsAt(time);
        const connectionDistance = width < 560 ? 270 : 390;

        context.lineWidth = 1;
        for (let i = 0; i < points.length; i += 1) {
          for (let j = i + 1; j < points.length; j += 1) {
            const dx = points[i].drawX - points[j].drawX;
            const dy = points[i].drawY - points[j].drawY;
            const distance = Math.hypot(dx, dy);
            if (distance > connectionDistance) continue;
            const opacity = 0.07 + (1 - distance / connectionDistance) * 0.27;
            context.strokeStyle = `rgba(7, 27, 48, ${opacity})`;
            context.beginPath();
            context.moveTo(points[i].drawX, points[i].drawY);
            context.lineTo(points[j].drawX, points[j].drawY);
            context.stroke();
          }
        }

        points.forEach(drawNode);

        if (!reducedMotion.matches) animationFrame = requestAnimationFrame(draw);
      };

      const onMotionChange = () => {
        cancelAnimationFrame(animationFrame);
        if (reducedMotion.matches) draw(0);
        else animationFrame = requestAnimationFrame(draw);
      };

      window.addEventListener("resize", resize, { passive: true, signal: controller.signal });
      reducedMotion.addEventListener("change", onMotionChange, { signal: controller.signal });
      resize();
      if (!reducedMotion.matches) animationFrame = requestAnimationFrame(draw);
      controller.signal.addEventListener("abort", () => cancelAnimationFrame(animationFrame), { once: true });
    };

    document.addEventListener("astro:page-load", setupCouncilNetwork);
    setupCouncilNetwork();
  </script>
</BaseLayout>
