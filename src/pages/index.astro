---
import BaseLayout from "../layouts/BaseLayout.astro";
import { currentNews } from "../data/news";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sitePath = (href: string) => `${base}${href}`;

const quickLinks = [
  ["Состав совета", "Кто представляет школьное сообщество", "/sostav/", "12"],
  ["Заседания", "Решения и протоколы 2025–2026", "/deyatelnost/resheniya/", "05"],
  ["Документы", "Нормативные акты, планы и отчёты", "/dokumenty/", "17"],
  ["Написать в совет", "Вопрос, предложение или инициатива", "/kontakty/", "→"]
];

const achievements = [
  {
    image: "/images/achievements/bezopasnost-truda-2024.jpg",
    year: "2024",
    title: "II место в форум-театре по охране труда"
  },
  {
    image: "/images/achievements/roditelskiy-patrul-2023.jpeg",
    year: "2023",
    title: "I место в конкурсе «Родительский патруль»"
  }
];
---

<BaseLayout
  title="Управляющий совет школы № 47 города Липецка"
  description="Состав, решения, документы, проекты и новости Управляющего совета МБОУ СОШ № 47 города Липецка."
  pageClass="home-network-page"
>
  <section class="hero home-hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <p class="eyebrow"><span></span> МБОУ СОШ № 47 · Липецк</p>
        <h1>Управляющий совет <em>школы № 47</em></h1>
        <p class="hero-lead">
          Родители, ученики, педагоги и партнёры вместе обсуждают важные вопросы
          и принимают решения, которые делают школьную жизнь лучше.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={sitePath("/sostav/")}>Состав совета</a>
          <a class="button button-ghost" href={sitePath("/kontakty/")}>Предложить инициативу</a>
        </div>
      </div>

      <figure class="home-hero-photo">
        <img
          src={sitePath("/images/news/roditelskoe-sobranie-i-zasedanie-soveta-2025/zasedanie-soveta.jpg")}
          alt="Заседание Управляющего совета школы № 47"
          loading="eager"
        />
        <figcaption><span>Совет в работе</span> Заседание Управляющего совета</figcaption>
      </figure>
    </div>
  </section>

  <nav class="home-quick-nav" aria-label="Быстрый доступ">
    <div class="container home-quick-grid">
      {quickLinks.map(([title, description, href, value]) => (
        <a href={sitePath(href)}>
          <span>{value}</span>
          <strong>{title}</strong>
          <small>{description}</small>
        </a>
      ))}
    </div>
  </nav>

  <section class="section home-about" id="about">
    <div class="container">
      <div class="section-heading heading-split">
        <div>
          <p class="eyebrow eyebrow-dark"><span></span> Совет в действии</p>
          <h2>Открыто говорим.<br /><em>Вместе решаем.</em></h2>
        </div>
        <p>
          Управляющий совет участвует в развитии школы, рассматривает условия обучения,
          безопасность, школьные проекты и предложения участников образовательных отношений.
          Решения совета и подтверждающие документы публикуются открыто.
        </p>
      </div>
      <div class="stats-grid verified-stats">
        <article><span class="stat-value">12</span><strong>членов совета</strong><p>Представляют родителей, учеников, работников школы и учредителя</p></article>
        <article><span class="stat-value">5</span><strong>заседаний за год</strong><p>Проведено в 2025–2026 учебном году</p></article>
        <article class="stat-accent"><span class="stat-value">17</span><strong>материалов</strong><p>Документы, протоколы, планы, отчёты и материалы проектов</p></article>
        <article><span class="stat-value">99%</span><strong>положительных оценок</strong><p>Организации воспитательной работы по итогам опроса</p></article>
      </div>
    </div>
  </section>

  <section class="section decisions-section home-decisions" id="decisions">
    <div class="container decisions-grid">
      <div>
        <p class="eyebrow eyebrow-light"><span></span> Заседания и решения</p>
        <h2>Работу совета<br /><em>можно проверить</em></h2>
        <p class="section-lead">
          Для каждого заседания опубликован протокол. Документы открываются в новом окне
          и доступны для скачивания.
        </p>
        <a class="button button-light" href={sitePath("/deyatelnost/resheniya/")}>Все заседания</a>
      </div>
      <div class="decision-list">
        <article>
          <div class="decision-top"><span class="status-chip status-done"><i></i> Проведено</span><time datetime="2026-05-20">20 мая 2026</time></div>
          <h3>Итоги учебного года и задачи на следующий период</h3>
          <a class="decision-document-link" href={sitePath("/documents/protokol-us-5-2026-05-20.pdf")} target="_blank" rel="noopener">Открыть протокол № 5 <span>→</span></a>
        </article>
        <article>
          <div class="decision-top"><span class="status-chip status-done"><i></i> Проведено</span><time datetime="2026-03-26">26 марта 2026</time></div>
          <h3>Организация образовательной среды и планирование работы</h3>
          <a class="decision-document-link" href={sitePath("/documents/protokol-us-4-2026-03-26.pdf")} target="_blank" rel="noopener">Открыть протокол № 4 <span>→</span></a>
        </article>
      </div>
    </div>
  </section>

  <section class="section news-section" id="news">
    <div class="container">
      <div class="section-heading heading-row">
        <div>
          <p class="eyebrow eyebrow-dark"><span></span> Последние события</p>
          <h2>Новости <em>школьного сообщества</em></h2>
        </div>
        <a class="text-link" href={sitePath("/novosti/")}>Все новости <span>→</span></a>
      </div>
      <div class="editorial-news-grid home-news-grid">
        {currentNews.slice(0, 3).map((item, index) => (
          <article class:list={["editorial-news-card", { "editorial-news-featured": index === 0 }]}>
            {item.coverImage || item.images?.[0] ? (
              <img class="editorial-news-image" src={sitePath((item.coverImage ?? item.images![0]).src)} alt={(item.coverImage ?? item.images![0]).alt} loading={index === 0 ? "eager" : "lazy"} />
            ) : null}
            <div>
              <div class="news-card-meta"><span>{item.categoryLabel}</span><time datetime={item.date}>{item.dateLabel}</time></div>
              <h3>{item.title}</h3>
              <p>{item.excerpt}</p>
              <a class="news-card-primary-link" href={sitePath(`/novosti/${item.slug}/`)}>Читать новость <span>→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section home-project-section">
    <div class="container home-project-card">
      <img src={sitePath("/images/news/roditeli-i-deti-itogi/obshchaya-fotografiya.jpg")} alt="Участники проекта «Родители и дети»" loading="lazy" />
      <div>
        <p class="eyebrow eyebrow-light"><span></span> Проект года</p>
        <h2>Играем в старину,<br /><em>живём в современности</em></h2>
        <p>Семейный проект объединил учеников 1–11 классов и их родителей вокруг традиционных игр, движения, общения и культурного наследия.</p>
        <a class="button button-light" href={sitePath("/deyatelnost/proekty/")}>Подробнее о проектах</a>
      </div>
    </div>
  </section>

  <section class="section home-achievements-section">
    <div class="container home-achievements-grid">
      <div class="home-achievements-copy">
        <p class="eyebrow eyebrow-dark"><span></span> Награды</p>
        <h2>Результаты <em>общей работы</em></h2>
        <p>Дипломы школы и команд в направлениях, связанных с безопасностью, участием родителей и развитием городской среды.</p>
        <a class="text-link" href={sitePath("/dostizheniya/")}>Все достижения <span>→</span></a>
      </div>
      <div class="home-awards-list">
        {achievements.map((item) => (
          <a href={sitePath("/dostizheniya/")}>
            <img src={sitePath(item.image)} alt="" loading="lazy" />
            <span><small>{item.year}</small><strong>{item.title}</strong></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-inner">
      <div>
        <p class="eyebrow eyebrow-light"><span></span> Есть предложение?</p>
        <h2>Ваш голос помогает<br /><em>принимать решения</em></h2>
      </div>
      <div>
        <p>Направьте в Управляющий совет вопрос, предложение или инициативу. Ответ придёт на указанную вами электронную почту.</p>
        <a class="button button-coral" href={sitePath("/kontakty/")}>Написать в совет</a>
      </div>
    </div>
  </section>
</BaseLayout>
