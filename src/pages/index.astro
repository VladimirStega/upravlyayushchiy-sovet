---
import BaseLayout from "../layouts/BaseLayout.astro";
import { currentNews } from "../data/news";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sitePath = (href: string) => `${base}${href}`;
---

<BaseLayout
  title="Управляющий совет — решения, которые меняют школу"
  description="Решения и новости Управляющего совета образовательной организации."
  pageClass="home-network-page"
>
  <canvas class="home-network-canvas" id="home-network-canvas" aria-hidden="true"></canvas>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <p class="eyebrow"><span></span> Управляющий совет</p>
        <h1>Решения, которые <em>меняют школу</em></h1>
        <p class="hero-lead">
          Объединяем учеников, родителей, педагогов и партнёров, чтобы вместе создавать
          открытую, безопасную и современную образовательную среду.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={sitePath("/o-sovete/")}>Узнать о совете</a>
          <a class="button button-ghost" href={sitePath("/kontakty/")}>Предложить инициативу</a>
        </div>
      </div>

      <div class="hero-visual hero-video-visual">
        <div class="photo-placeholder photo-placeholder-main hero-video-main">
          <a class="video-play-link" href={sitePath("/video/")} aria-label="Перейти к видеоматериалам">▶</a>
          <strong>Презентационный ролик</strong>
          <small>Видео об Управляющем совете · до 5 минут · 16:9</small>
        </div>
      </div>
    </div>
  </section>

  <section class="section impact-section" id="about">
    <div class="container">
      <div class="section-heading heading-split">
        <div>
          <p class="eyebrow eyebrow-dark"><span></span> Совет в действии</p>
          <h2>Открыто говорим.<br /><em>Вместе решаем.</em></h2>
        </div>
        <p>
          Здесь появится краткое описание миссии и полномочий Управляющего совета.
          Текст должен объяснять, какие вопросы решает совет и как жители школьного
          сообщества могут участвовать в его работе.
        </p>
      </div>
      <div class="stats-grid">
        <article><span class="stat-value">12</span><strong>членов совета</strong><p>Утверждённый состав на 2025–2026 учебный год</p></article>
        <article><span class="stat-value">__</span><strong>заседаний за год</strong><p>Здесь будет подтверждённое число проведённых заседаний</p></article>
        <article class="stat-accent"><span class="stat-value">__</span><strong>реализованных проектов</strong><p>Количество инициатив с измеримым результатом</p></article>
        <article><span class="stat-value">__</span><strong>участников опросов</strong><p>Обучающиеся, родители и работники образовательной организации</p></article>
      </div>
    </div>
  </section>

  <section class="section decisions-section" id="decisions">
    <div class="container decisions-grid">
      <div>
        <p class="eyebrow eyebrow-light"><span></span> От предложения к результату</p>
        <h2>Каждое решение<br /><em>можно проверить</em></h2>
        <p class="section-lead">
          Здесь показываем путь от предложения до исполненного решения. Полный архив
          решений и протоколов размещён на отдельной странице.
        </p>
        <a class="button button-light" href={sitePath("/deyatelnost/resheniya/")}>Все решения</a>
      </div>
      <div class="decision-list">
        <article>
          <div class="decision-top"><span class="status-chip status-progress"><i></i> В работе</span><time>Указать дату</time></div>
          <h3>Здесь будет название актуального решения Управляющего совета</h3>
          <div class="progress"><span style="width: 62%"></span></div>
          <p>Ответственный: <strong>указать комиссию или участника</strong></p>
        </article>
        <article>
          <div class="decision-top"><span class="status-chip status-done"><i></i> Выполнено</span><time>Указать дату</time></div>
          <h3>Здесь будет название выполненного решения Управляющего совета</h3>
          <div class="progress"><span style="width: 100%"></span></div>
          <p>Результат: <strong>добавить подтверждённый результат</strong></p>
        </article>
      </div>
    </div>
  </section>

  <section class="section news-section" id="news">
    <div class="container">
      <div class="section-heading heading-row">
        <div>
          <p class="eyebrow eyebrow-dark"><span></span> Новости совета</p>
          <h2>Работа совета — <em>в деталях</em></h2>
        </div>
        <a class="text-link" href={sitePath("/novosti/")}>Все новости <span>→</span></a>
      </div>
      <div class="editorial-news-grid">
        {currentNews.slice(0, 3).map((item, index) => (
          <article class:list={["editorial-news-card", { "editorial-news-featured": index === 0 }]}>
            <div class="photo-placeholder editorial-news-image">
              <span class="placeholder-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="m6 37 11-13 8 8 6-7 11 12"/><circle cx="34" cy="14" r="5"/></svg></span>
              <strong>{item.mediaLabel}</strong>
            </div>
            <div>
              <div class="news-card-meta"><span>{item.categoryLabel}</span><time datetime={item.date}>{item.dateLabel}</time></div>
              <h3>{item.title}</h3>
              <p>{item.excerpt}</p>
              <div class="news-card-actions">
                <a href={sitePath(`/novosti/${item.slug}/`)}>Читать новость <span>→</span></a>
                <a class="news-source-link" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">Посмотреть во ВКонтакте</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-inner">
      <div>
        <p class="eyebrow eyebrow-light"><span></span> Есть предложение?</p>
        <h2>Ваш голос помогает<br /><em>принимать решения</em></h2>
      </div>
      <div>
        <p>Здесь будет краткое приглашение направить вопрос, инициативу или предложение в Управляющий совет.</p>
        <a class="button button-coral" href={sitePath("/kontakty/")}>Написать в совет</a>
      </div>
    </div>
  </section>

  <script>
    const setupCouncilNetwork = () => {
      const canvas = document.querySelector("#home-network-canvas");
      if (!(canvas instanceof HTMLCanvasElement)) return;

      const previousController = (window as any).__councilNetworkController as AbortController | undefined;
      previousController?.abort();
      const controller = new AbortController();
      (window as any).__councilNetworkController = controller;

      const context = canvas.getContext("2d");
      if (!context) return;

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let width = 0;
      let height = 0;
      let worldHeight = 0;
      let pixelRatio = 1;
      let animationFrame = 0;
      let previousScroll = window.scrollY;
      let scrollEnergy = 0;
      type NodeKind = "dot" | "person" | "dialog" | "book" | "document" | "idea" | "result" | "school";
      let nodes: Array<{ id: number; x: number; worldY: number; phase: number; speed: number; radius: number; amplitude: number; emphasis: boolean; kind: NodeKind; velocityX: number; lifeOffset: number; lifeSpeed: number; linePhase: number }> = [];

      const seeded = (seed: number) => {
        const value = Math.sin(seed * 9283.17 + 78.23) * 43758.5453;
        return value - Math.floor(value);
      };

      const createNodes = () => {
        const main = document.querySelector("main");
        worldHeight = Math.max(main?.scrollHeight || height, height);
        const visibleCount = width < 560 ? 13 : width < 900 ? 18 : 24;
        const count = Math.ceil((worldHeight / height) * visibleCount);
        const kinds: NodeKind[] = ["dot", "person", "dot", "dialog", "dot", "book", "document", "dot", "idea", "dot", "result", "school", "dot", "person", "dot", "dialog", "dot", "document"];
        const placed: typeof nodes = [];
        for (let index = 0; index < count; index += 1) {
          const kind = kinds[index % kinds.length];
          const radius = kind === "dot"
            ? 3.5 + seeded(index * 7 + 3) * 4.5
            : (width < 560 ? 12 : 15) + seeded(index * 7 + 3) * (width < 560 ? 8 : 14);
          const direction = seeded(index * 29 + 12) > 0.5 ? 1 : -1;

          placed.push({
            id: index,
            x: width * (0.04 + seeded(index * 11 + 5) * 0.92),
            worldY: ((index + seeded(index * 13 + 9) * 0.8) / count) * worldHeight,
            phase: seeded(index * 17 + 6) * Math.PI * 2,
            speed: 0.82 + seeded(index * 19 + 8) * 0.68,
            radius,
            amplitude: (kind === "dot" ? 18 : 34) + seeded(index * 23 + 10) * (kind === "dot" ? 25 : 48),
            emphasis: kind !== "dot" && index % 5 === 0,
            kind,
            velocityX: direction * (0.006 + seeded(index * 31 + 14) * 0.009),
            lifeOffset: seeded(index * 37 + 16),
            lifeSpeed: 0.000008 + seeded(index * 41 + 18) * 0.000006,
            linePhase: seeded(index * 43 + 20) * Math.PI * 2
          });
        }
        nodes = placed;
      };

      const resize = () => {
        width = window.innerWidth;
        height = window.innerHeight;
        pixelRatio = Math.min(window.devicePixelRatio || 1, 1.5);
        canvas.width = Math.round(width * pixelRatio);
        canvas.height = Math.round(height * pixelRatio);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        createNodes();
        if (reducedMotion.matches) draw(0);
      };

      const smoothstep = (start: number, end: number, value: number) => {
        const normalized = Math.max(0, Math.min(1, (value - start) / (end - start)));
        return normalized * normalized * (3 - 2 * normalized);
      };

      const positionsAt = (time: number) => nodes.map((node) => {
        const lifecycle = (time * node.lifeSpeed + node.lifeOffset) % 1;
        const alpha = reducedMotion.matches
          ? 1
          : smoothstep(0.015, 0.11, lifecycle) * (1 - smoothstep(0.86, 0.965, lifecycle));
        const trackWidth = width + 180;
        const movingX = reducedMotion.matches ? node.x : ((node.x + time * node.velocityX + 90) % trackWidth + trackWidth) % trackWidth - 90;
        const driftY = reducedMotion.matches ? 0 : Math.cos(time * 0.00012 * node.speed + node.phase * 1.37) * node.amplitude * 0.62;
        const wave = reducedMotion.matches ? 0 : Math.sin(node.worldY * 0.008 + node.phase) * scrollEnergy * 3.5;
        return {
          ...node,
          lifecycle,
          alpha,
          drawX: movingX,
          drawY: node.worldY - window.scrollY + driftY + wave
        };
      });

      const drawNode = (point: ReturnType<typeof positionsAt>[number]) => {
        const { drawX, drawY, radius, emphasis, kind } = point;
        context.save();
        context.globalAlpha = point.alpha;
        context.translate(drawX, drawY);

        if (kind === "dot") {
          context.fillStyle = "#0d253f";
          context.beginPath();
          context.arc(0, 0, radius, 0, Math.PI * 2);
          context.fill();
          context.restore();
          return;
        }

        context.shadowColor = "rgba(4, 17, 32, 0.28)";
        context.shadowBlur = emphasis ? 18 : 10;
        context.fillStyle = emphasis ? "#d9eee6" : "#c8d9df";
        context.strokeStyle = "#0d253f";
        context.lineWidth = emphasis ? 1.6 : 1.1;
        context.beginPath();
        context.arc(0, 0, radius, 0, Math.PI * 2);
        context.fill();
        context.stroke();
        context.shadowBlur = 0;

        const scale = radius / 22;
        context.scale(scale, scale);
        context.strokeStyle = "rgba(8, 27, 47, 0.94)";
        context.fillStyle = "rgba(8, 27, 47, 0.9)";
        context.lineWidth = 1.7 / scale;
        context.lineCap = "round";
        context.lineJoin = "round";

        if (kind === "person") {
          context.beginPath();
          context.arc(0, -5, 4, 0, Math.PI * 2);
          context.fill();
          context.beginPath();
          context.moveTo(-9, 10);
          context.quadraticCurveTo(-7, 1, 0, 1);
          context.quadraticCurveTo(7, 1, 9, 10);
          context.closePath();
          context.fill();
        } else if (kind === "dialog") {
          context.beginPath();
          context.roundRect(-11, -8, 22, 15, 4);
          context.moveTo(-3, 7);
          context.lineTo(-7, 12);
          context.lineTo(2, 7);
          context.stroke();
          [-6, 0, 6].forEach((x) => {
            context.beginPath();
            context.arc(x, -1, 1.25, 0, Math.PI * 2);
            context.fill();
          });
        } else if (kind === "book") {
          context.beginPath();
          context.moveTo(0, -8);
          context.quadraticCurveTo(-5, -11, -11, -8);
          context.lineTo(-11, 9);
          context.quadraticCurveTo(-5, 6, 0, 10);
          context.quadraticCurveTo(5, 6, 11, 9);
          context.lineTo(11, -8);
          context.quadraticCurveTo(5, -11, 0, -8);
          context.lineTo(0, 10);
          context.stroke();
        } else if (kind === "document") {
          context.strokeRect(-8, -11, 16, 22);
          [-5, 0, 5].forEach((y, index) => {
            context.beginPath();
            context.moveTo(-4, y);
            context.lineTo(index === 2 ? 3 : 5, y);
            context.stroke();
          });
        } else if (kind === "idea") {
          context.beginPath();
          context.arc(0, -3, 7, Math.PI * 0.15, Math.PI * 0.85, true);
          context.quadraticCurveTo(-5, 3, -3, 6);
          context.lineTo(3, 6);
          context.quadraticCurveTo(5, 3, 6.2, 0);
          context.stroke();
          context.beginPath();
          context.moveTo(-3, 9);
          context.lineTo(3, 9);
          context.moveTo(-1.8, 12);
          context.lineTo(1.8, 12);
          context.stroke();
        } else if (kind === "result") {
          context.beginPath();
          context.arc(0, 0, 11, 0, Math.PI * 2);
          context.moveTo(-5, 0);
          context.lineTo(-1, 5);
          context.lineTo(7, -5);
          context.stroke();
        } else {
          context.beginPath();
          context.moveTo(-11, -3);
          context.lineTo(0, -11);
          context.lineTo(11, -3);
          context.moveTo(-8, -3);
          context.lineTo(-8, 10);
          context.lineTo(8, 10);
          context.lineTo(8, -3);
          context.moveTo(-3, 10);
          context.lineTo(-3, 2);
          context.lineTo(3, 2);
          context.lineTo(3, 10);
          context.stroke();
        }

        if (emphasis) {
          context.scale(1 / scale, 1 / scale);
          context.strokeStyle = "rgba(221, 239, 246, 0.42)";
          context.lineWidth = 1;
          context.beginPath();
          context.arc(0, 0, radius + 6, 0, Math.PI * 2);
          context.stroke();
        }
        context.restore();
      };

      const draw = (time: number) => {
        if (!canvas.isConnected || controller.signal.aborted) return;
        context.clearRect(0, 0, width, height);
        const points = positionsAt(time).filter((point) => point.alpha > 0.015 && point.drawY > -560 && point.drawY < height + 560);
        const connectionDistance = width < 560 ? 270 : 390;
        const endpointGlows: Array<{ x: number; y: number; radius: number; intensity: number }> = [];
        const sourceGlows: Array<{ x: number; y: number; radius: number; intensity: number }> = [];

        context.lineWidth = 1;
        for (let i = 0; i < points.length; i += 1) {
          for (let j = i + 1; j < points.length; j += 1) {
            const dx = points[i].drawX - points[j].drawX;
            const dy = points[i].drawY - points[j].drawY;
            const distance = Math.hypot(dx, dy);
            const primary = (points[i].id * 7 + points[j].id * 11) % 4 === 0;
            const pulse = (Math.sin(time * 0.000075 + points[i].linePhase + points[j].linePhase) + 1) / 2;
            const visibility = primary ? 0.68 + pulse * 0.32 : smoothstep(0.25, 0.72, pulse);
            const opacity = (primary ? 0.18 : 0.085) + (1 - distance / connectionDistance) * (primary ? 0.32 : 0.18);
            const connectionAlpha = Math.min(points[i].alpha, points[j].alpha);
            const signalSpeed = 0.00012;
            const signalOffset = ((points[i].id * 13 + points[j].id * 17) % 97) / 97;
            const signalCycle = (time * signalSpeed + signalOffset) % 1;
            const signalStartTime = time - signalCycle / signalSpeed;
            const startLifecycleA = ((signalStartTime * points[i].lifeSpeed + points[i].lifeOffset) % 1 + 1) % 1;
            const startLifecycleB = ((signalStartTime * points[j].lifeSpeed + points[j].lifeOffset) % 1 + 1) % 1;
            const startTrackWidth = width + 180;
            const startX1 = ((points[i].x + signalStartTime * points[i].velocityX + 90) % startTrackWidth + startTrackWidth) % startTrackWidth - 90;
            const startX2 = ((points[j].x + signalStartTime * points[j].velocityX + 90) % startTrackWidth + startTrackWidth) % startTrackWidth - 90;
            const startY1 = points[i].worldY - window.scrollY + Math.cos(signalStartTime * 0.00012 * points[i].speed + points[i].phase * 1.37) * points[i].amplitude * 0.62;
            const startY2 = points[j].worldY - window.scrollY + Math.cos(signalStartTime * 0.00012 * points[j].speed + points[j].phase * 1.37) * points[j].amplitude * 0.62;
            const startDistance = Math.hypot(startX1 - startX2, startY1 - startY2);
            const stableSignal = primary
              && (points[i].id * 5 + points[j].id * 3) % 9 === 0
              && startDistance < connectionDistance * 0.86
              && startX1 > 150
              && startX1 < width - 150
              && startX2 > 150
              && startX2 < width - 150
              && startLifecycleA > 0.14
              && startLifecycleA < 0.68
              && startLifecycleB > 0.14
              && startLifecycleB < 0.68
              && !reducedMotion.matches;
            const carriesSignal = stableSignal && signalCycle < 0.74;
            if (distance > connectionDistance && !(carriesSignal && distance < connectionDistance * 1.48)) continue;
            const lineAlpha = Math.max(0, opacity) * Math.max(visibility, carriesSignal ? 0.9 : 0) * connectionAlpha;
            context.strokeStyle = `rgba(13, 37, 63, ${lineAlpha})`;
            context.beginPath();
            context.moveTo(points[i].drawX, points[i].drawY);
            context.lineTo(points[j].drawX, points[j].drawY);
            context.stroke();

            if (carriesSignal) {
              const growthEnd = 0.24;
              const arrivalStart = 0.48;
              const growth = Math.max(0, Math.min(1, signalCycle / growthEnd));
              const rush = Math.max(0, Math.min(1, (signalCycle - growthEnd) / (arrivalStart - growthEnd)));
              const progress = signalCycle <= growthEnd
                ? 0.18 * (0.35 * growth + 0.65 * growth * growth)
                : 0.18 + 0.82 * (0.55 * rush + 0.45 * rush * rush);
              const size = 0.16 + smoothstep(0, 1, growth) * 0.84;
              const trailLength = 0.014 + size * 0.09;
              const tailProgress = Math.max(0, progress - trailLength);
              const startX = points[i].drawX;
              const startY = points[i].drawY;
              const endX = points[j].drawX;
              const endY = points[j].drawY;
              const tailX = startX + (endX - startX) * tailProgress;
              const tailY = startY + (endY - startY) * tailProgress;
              const headX = startX + (endX - startX) * progress;
              const headY = startY + (endY - startY) * progress;
              const signalAlpha = connectionAlpha * smoothstep(0, 0.05, signalCycle) * (1 - smoothstep(arrivalStart, 0.67, signalCycle));
              const signalGradient = context.createLinearGradient(tailX, tailY, headX, headY);
              signalGradient.addColorStop(0, "rgba(177, 240, 220, 0)");
              signalGradient.addColorStop(0.52, `rgba(177, 240, 220, ${signalAlpha * 0.42})`);
              signalGradient.addColorStop(1, `rgba(239, 255, 249, ${signalAlpha})`);

              context.save();
              context.strokeStyle = `rgba(174, 235, 214, ${signalAlpha * 0.2})`;
              context.lineWidth = 1.25;
              context.shadowColor = `rgba(174, 235, 214, ${signalAlpha * 0.42})`;
              context.shadowBlur = 5;
              context.beginPath();
              context.moveTo(startX, startY);
              context.lineTo(headX, headY);
              context.stroke();

              context.strokeStyle = signalGradient;
              context.lineWidth = 1.2 + size * 3.3;
              context.lineCap = "round";
              context.shadowColor = `rgba(174, 235, 214, ${signalAlpha * 0.9})`;
              context.shadowBlur = 7 + size * 11;
              context.beginPath();
              context.moveTo(tailX, tailY);
              context.lineTo(headX, headY);
              context.stroke();
              context.restore();

              const sourceCharge = smoothstep(0, 1, growth) * (1 - smoothstep(0.24, 0.38, signalCycle));
              if (sourceCharge > 0.01) {
                sourceGlows.push({
                  x: startX,
                  y: startY,
                  radius: points[i].radius,
                  intensity: sourceCharge * connectionAlpha
                });
              }

              if (signalCycle > 0.44) {
                const arrival = smoothstep(0.44, 0.51, signalCycle) * (1 - smoothstep(0.66, 0.74, signalCycle));
                endpointGlows.push({
                  x: endX,
                  y: endY,
                  radius: points[j].radius,
                  intensity: arrival * connectionAlpha
                });
              }
            }
          }
        }

        sourceGlows.forEach((glow) => {
          const haloRadius = glow.radius + 9 + 13 * glow.intensity;
          const halo = context.createRadialGradient(glow.x, glow.y, glow.radius * 0.28, glow.x, glow.y, haloRadius);
          halo.addColorStop(0, `rgba(239, 255, 249, ${glow.intensity * 0.68})`);
          halo.addColorStop(0.34, `rgba(174, 235, 214, ${glow.intensity * 0.44})`);
          halo.addColorStop(1, "rgba(174, 235, 214, 0)");
          context.fillStyle = halo;
          context.beginPath();
          context.arc(glow.x, glow.y, haloRadius, 0, Math.PI * 2);
          context.fill();
        });

        endpointGlows.forEach((glow) => {
          const haloRadius = glow.radius + 12 * glow.intensity;
          const halo = context.createRadialGradient(glow.x, glow.y, glow.radius * 0.35, glow.x, glow.y, haloRadius);
          halo.addColorStop(0, `rgba(231, 255, 246, ${glow.intensity * 0.54})`);
          halo.addColorStop(0.42, `rgba(174, 235, 214, ${glow.intensity * 0.3})`);
          halo.addColorStop(1, "rgba(174, 235, 214, 0)");
          context.fillStyle = halo;
          context.beginPath();
          context.arc(glow.x, glow.y, haloRadius, 0, Math.PI * 2);
          context.fill();
        });

        points.forEach(drawNode);
        scrollEnergy *= 0.91;

        if (!reducedMotion.matches) animationFrame = requestAnimationFrame(draw);
      };

      const onMotionChange = () => {
        cancelAnimationFrame(animationFrame);
        if (reducedMotion.matches) draw(0);
        else animationFrame = requestAnimationFrame(draw);
      };

      const onScroll = () => {
        const delta = window.scrollY - previousScroll;
        scrollEnergy = Math.min(1, scrollEnergy + Math.abs(delta) / 180);
        previousScroll = window.scrollY;
        if (reducedMotion.matches) draw(0);
      };

      window.addEventListener("resize", resize, { passive: true, signal: controller.signal });
      window.addEventListener("scroll", onScroll, { passive: true, signal: controller.signal });
      reducedMotion.addEventListener("change", onMotionChange, { signal: controller.signal });
      const main = document.querySelector("main");
      const mainObserver = main instanceof HTMLElement ? new ResizeObserver(() => {
        const nextHeight = Math.max(main.scrollHeight, window.innerHeight);
        if (Math.abs(nextHeight - worldHeight) > 40) createNodes();
      }) : null;
      if (main instanceof HTMLElement) mainObserver?.observe(main);
      resize();
      if (!reducedMotion.matches) animationFrame = requestAnimationFrame(draw);
      controller.signal.addEventListener("abort", () => {
        cancelAnimationFrame(animationFrame);
        mainObserver?.disconnect();
      }, { once: true });
    };

    document.addEventListener("astro:page-load", setupCouncilNetwork);
    setupCouncilNetwork();
  </script>
</BaseLayout>
