---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { archivedNews } from "../data/news";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const years = [...new Set(archivedNews.map((item) => item.year))].sort((a, b) => b - a);
---

<BaseLayout title="Архив — Управляющий совет" current="Архив">
  <PageHero
    eyebrow="Материалы прошлых лет"
    title="Архив"
    accent="Управляющего совета"
    description="Публикации о заседаниях, проектах и работе школьного сообщества за 2018–2023 годы."
  />
  <section class="section content-section">
    <div class="container archive-news-sections">
      {years.map((year) => (
        <section class="archive-year" aria-labelledby={`archive-${year}`}>
          <div class="archive-year-heading">
            <h2 id={`archive-${year}`}>{year} <em>год</em></h2>
            <span>{archivedNews.filter((item) => item.year === year).length} публикации</span>
          </div>
          <div class="editorial-news-grid archive-news-grid">
            {archivedNews.filter((item) => item.year === year).map((item, index) => (
              <article class:list={["editorial-news-card", { "editorial-news-no-image": !item.coverImage && !item.images?.[0] }]}>
                {item.coverImage || item.images?.[0] ? (
                  <img
                    class="editorial-news-image"
                    src={`${base}${(item.coverImage ?? item.images![0]).src}`}
                    alt={(item.coverImage ?? item.images![0]).alt}
                    loading={index === 0 ? "eager" : "lazy"}
                  />
                ) : null}
                <div>
                  <div class="news-card-meta"><span>{item.categoryLabel}</span><time datetime={item.date}>{item.dateLabel}</time></div>
                  <h3>{item.title}</h3>
                  <p>{item.excerpt}</p>
                  <div class="news-card-actions">
                    <a href={`${base}/novosti/${item.slug}/`}>Читать публикацию <span>→</span></a>
                    {item.sourceUrl && <a class="news-source-link" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">Посмотреть во ВКонтакте</a>}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
