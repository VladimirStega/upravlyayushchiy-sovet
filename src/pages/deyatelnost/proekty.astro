---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import PhotoPlaceholder from "../../components/PhotoPlaceholder.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="Проекты — Управляющий совет" current="Деятельность">
  <PageHero eyebrow="Инициативы и результаты" title="Проекты" accent="Управляющего совета" description="Проекты, которые совет инициировал, поддержал или реализовал вместе с родителями, учениками и педагогами." />
  <section class="section content-section">
    <div class="container">
      <div class="projects-grid">
        <article class="project-card project-card-large"><img class="project-photo" src={`${base}/images/news/roditeli-i-deti-itogi/obshchaya-fotografiya.jpg`} alt="Участники проекта «Родители и дети» на общей фотографии" loading="lazy" /><div class="project-body"><span class="project-tag">Реализован в 2025 году</span><h3>«Родители и дети: играем в старину, живём в современности»</h3><p>Совместный проект для учеников 1–11 классов и их родителей: традиционные игры, семейное общение, диалог поколений и знакомство с культурным наследием. Проект получил поддержку Российского общества «Знание» в размере 500 000 рублей.</p><div class="project-links"><a class="text-link" href={`${base}/novosti/roditeli-i-deti-itogi-igry/`}>Посмотреть итоги →</a><a class="text-link" href={`${base}/documents/projects/roditeli-i-deti.pptx`} download>Скачать презентацию ↓</a></div></div></article>
        <article class="project-card"><PhotoPlaceholder title="Фотография проекта «Окна воспоминаний»" note="Добавить фотографию готовой экспозиции" className="project-photo" /><div class="project-body"><span class="project-tag">Проект Управляющего совета</span><h3>«Окна воспоминаний»</h3><p>Инициатива по сохранению исторической памяти и семейных историй. Проект объединяет школьное сообщество вокруг бережного отношения к прошлому и совместной творческой работы.</p><div class="project-links"><a class="text-link" href={`${base}/documents/projects/okna-vospominaniy.pdf`} target="_blank" rel="noopener">Открыть описание проекта →</a></div></div></article>
      </div>
      <div class="page-section-heading practice-heading"><div><p class="eyebrow eyebrow-dark"><span></span> Практики и опыт работы</p><h2>«Человек и <em>деятельность</em>»</h2></div><p>Действующая в 2023–2026 годах практика по трудовому воспитанию и профессиональному самоопределению обучающихся.</p></div>
      <article class="practice-card">
        <PhotoPlaceholder title="Фотография профориентационного мероприятия" note="Добавить фотографию участников" className="practice-photo" />
        <div><span class="project-tag">Практика школы и Управляющего совета</span><h3>Трудовое воспитание и профессиональное самоопределение</h3><p>Система работы с участием Управляющего совета, педагогов, родителей и социальных партнёров помогает обучающимся знакомиться с профессиями, трудовой деятельностью и возможностями дальнейшего образования.</p><a class="text-link" href={`${base}/documents/projects/chelovek-i-deyatelnost.pdf`} target="_blank" rel="noopener">Открыть материалы практики →</a></div>
      </article>
      <div class="project-overview-download">
        <div><span class="project-tag">Общий материал</span><h2>Основные направления деятельности и проекты</h2><p>Сводный материал о направлениях работы Управляющего совета.</p></div>
        <a class="button button-primary" href={`${base}/documents/projects/napravleniya-i-proekty-us.pdf`} target="_blank" rel="noopener">Открыть PDF →</a>
      </div>
    </div>
  </section>
</BaseLayout>
