---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import PhotoPlaceholder from "../../components/PhotoPlaceholder.astro";
---

<BaseLayout title="Проекты — Управляющий совет" current="Деятельность">
  <PageHero eyebrow="Инициативы и результаты" title="Проекты" accent="Управляющего совета" description="Каталог собственных и поддержанных проектов с задачами, ресурсами, ходом реализации и измеримыми результатами." />
  <section class="section content-section">
    <div class="container">
      <div class="category-filter"><span>Все проекты</span><span>Текущие</span><span>Завершённые</span><span>Поддержанные</span><span>2026/27</span><span>Архив</span></div>
      <div class="projects-grid">
        <article class="project-card project-card-large"><PhotoPlaceholder title="Фотография основного проекта" note="Добавить горизонтальный снимок результата" className="project-photo" /><div class="project-body"><span class="project-tag">Текущий проект</span><h3>Название основного проекта Управляющего совета</h3><p>Проблема, действия, участники и измеримый результат.</p></div></article>
        <article class="project-card"><PhotoPlaceholder title="Фотография проекта" className="project-photo" /><div class="project-body"><span class="project-tag">Поддержанный проект</span><h3>Название поддержанного проекта</h3><p>Добавить сведения о поддержке и привлечённых ресурсах.</p></div></article>
        <article class="project-card project-card-accent"><div class="project-index">03</div><div class="project-body"><span class="project-tag">Завершённый проект</span><h3>Название проекта с подтверждённым результатом</h3><p>Добавить цифры, документы, фотографии и отзывы участников.</p></div></article>
      </div>
    </div>
  </section>
</BaseLayout>
