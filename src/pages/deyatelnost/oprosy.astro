---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const surveyDocuments = [
  [
    "03_uchebnaya_nagruzka",
    "Удовлетворённость учебной нагрузкой и организацией образовательного процесса",
    "Сентябрь 2026",
    "Учащиеся и родители"
  ],
  [
    "06_semya_i_shkola",
    "Удовлетворённость взаимодействием семьи и школы",
    "Сентябрь 2026",
    "Родители"
  ],
  [
    "02_informatsionnaya_otkrytost",
    "Удовлетворённость информационной открытостью школы",
    "Март 2026",
    "Родители"
  ],
  [
    "07_shkolnye_meropriyatiya",
    "Удовлетворённость организацией школьных мероприятий и праздников",
    "Ноябрь 2025",
    "Учащиеся и родители"
  ],
  [
    "04_vneurochnaya_deyatelnost",
    "Удовлетворённость внеурочной деятельностью и дополнительным образованием",
    "Февраль 2025",
    "Учащиеся и родители"
  ],
  [
    "05_usloviya_shkoly",
    "Удовлетворённость материально-техническими и санитарно-бытовыми условиями школы",
    "Сентябрь 2024",
    "Учащиеся и родители"
  ],
  [
    "01_shkolnoe_pitanie",
    "Удовлетворённость качеством школьного питания",
    "Январь 2024",
    "Учащиеся и родители"
  ]
];

const surveyMetrics = [
  ["Доброжелательность и вежливость", 90],
  ["Компетентность работников", 94],
  ["Удовлетворённость услугами", 90],
  ["Готовность рекомендовать школу", 88],
  ["Организация воспитательной работы", 99]
];
---

<BaseLayout title="Опросы и решения — Управляющий совет" current="Деятельность">
  <PageHero eyebrow="Мнение сообщества" title="Опросы и" accent="результаты" description="Обезличенные результаты исследований, которые помогают совету учитывать мнение учеников и родителей." />
  <section class="section content-section">
    <div class="container">
      <div class="survey-toolbar">
        <div>
          <p class="eyebrow eyebrow-dark"><span></span> Актуальная информация</p>
          <h2>Опросы <em>Управляющего совета</em></h2>
        </div>
      </div>

      <article class="survey-featured">
        <div>
          <span class="survey-status done">Сбор ответов завершён</span>
          <h2>Удовлетворённость качеством условий образовательной деятельности</h2>
          <p>Анонимный опрос обучающихся и родителей проведён Управляющим советом в апреле 2026 года.</p>
          <dl class="survey-meta">
            <div><dt>Обучающиеся</dt><dd>13% учеников 4–11 классов</dd></div>
            <div><dt>Родители</dt><dd>14% родителей 2–11 классов</dd></div>
            <div><dt>Формат</dt><dd>Анонимное анкетирование</dd></div>
          </dl>
        </div>
        <div class="survey-featured-visual">
          <strong>Главный результат</strong>
          <b>99%</b>
          <p>положительно оценили организацию воспитательной работы</p>
          <small>Результаты представлены в обезличенном виде</small>
        </div>
      </article>
    </div>
  </section>

  <section class="section survey-results-section">
    <div class="container">
      <div class="page-section-heading">
        <div><p class="eyebrow eyebrow-dark"><span></span> Апрель 2026</p><h2>Основные <em>показатели</em></h2></div>
        <p>Доля положительных оценок по ключевым направлениям работы образовательной организации.</p>
      </div>
      <div class="survey-metrics-grid">
        {surveyMetrics.map(([label, value]) => (
          <article class="survey-metric-card">
            <strong>{value}%</strong>
            <h3>{label}</h3>
            <div class="survey-metric-bar" aria-label={`${value}% положительных оценок`}><i style={`width: ${value}%`}></i></div>
          </article>
        ))}
      </div>
      <article class="survey-conclusion"><span>Вывод</span><p>Результаты показывают высокий уровень положительной оценки условий образовательной деятельности. Материалы опроса использованы Управляющим советом при подведении итогов работы за учебный год.</p></article>
      <a class="button button-primary survey-download" href={`${base}/documents/rezultaty-oprosa-us-2026.pdf`} target="_blank" rel="noopener">Открыть полные результаты опроса →</a>
    </div>
  </section>

  <section class="section content-section survey-documents-section">
    <div class="container">
      <div class="page-section-heading">
        <div><p class="eyebrow eyebrow-dark"><span></span> 2024–2026</p><h2>Тематические <em>опросы</em></h2></div>
        <p>Аналитические материалы по семи направлениям: результаты, показатели и выводы.</p>
      </div>
      <div class="document-list standalone-documents">
        {surveyDocuments.map(([file, title, date, audience]) => (
          <a href={`${base}/documents/surveys/${file}.docx`} download>
            <span class="file-icon">DOCX</span>
            <span><strong>{title}</strong><small>{date} · {audience} · Скачать документ</small></span>
            <i aria-hidden="true">↓</i>
          </a>
        ))}
      </div>
      <p style="margin-top: 24px"><a class="button button-primary" href={`${base}/documents/surveys/oprosy-2024-2026.zip`} download>Скачать все 7 документов · ZIP ↓</a></p>
    </div>
  </section>

  <section class="section survey-process-section">
    <div class="container">
      <div class="page-section-heading">
        <h2>Как мнение становится <em>решением</em></h2>
        <p>Понятный путь от сбора ответов до публичного отчёта о выполненной работе.</p>
      </div>
      <div class="survey-publication-flow">
        <article><span>Опрос</span><h3>Собираем мнения</h3><p>Публикуем цель, аудиторию, сроки и ссылку на анкету.</p></article>
        <article><span>Результаты</span><h3>Показываем данные</h3><p>Размещаем обезличенную статистику, диаграммы и основные выводы.</p></article>
        <article><span>Решение</span><h3>Фиксируем действие</h3><p>Указываем решение совета, протокол, сроки и ответственных.</p></article>
        <article><span>Исполнение</span><h3>Подтверждаем результат</h3><p>Добавляем итог, документы, фотографии и статус выполнения.</p></article>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .survey-documents-section { position: relative; z-index: 2; }
</style>
