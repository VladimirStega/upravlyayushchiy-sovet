---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sitePath = (href: string) => `${base}${href}`;
---

<BaseLayout title="Деятельность — Управляющий совет" current="Деятельность">
  <PageHero
    eyebrow="От обсуждения к результату"
    title="Деятельность"
    accent="Управляющего совета"
    description="Единая точка входа в решения, заседания, проекты, опросы и практику использования цифровых ресурсов и искусственного интеллекта."
  />
  <section class="section content-section">
    <div class="container content-grid two-columns">
      <article class="content-card dark"><span class="content-card-number">01</span><h2>Решения и заседания</h2><p>Повестки, протоколы, публичные выписки и контроль исполнения решений.</p><a class="text-link" href={sitePath("/deyatelnost/resheniya/")}>Открыть раздел <span>→</span></a></article>
      <article class="content-card"><span class="content-card-number">02</span><h2>Проекты</h2><p>Текущие, завершённые и поддержанные Управляющим советом инициативы.</p><a class="text-link" href={sitePath("/deyatelnost/proekty/")}>Открыть раздел <span>→</span></a></article>
      <article class="content-card"><span class="content-card-number">03</span><h2>Опросы</h2><p>Мнение сообщества, результаты, аналитика и решения по итогам опросов.</p><a class="text-link" href={sitePath("/deyatelnost/oprosy/")}>Открыть раздел <span>→</span></a></article>
      <article class="content-card accent"><span class="content-card-number">04</span><h2>Цифровая практика и ИИ</h2><p>Конкурсная практика, инструкции, материалы и подтверждение апробации.</p><a class="text-link" href={sitePath("/deyatelnost/cifrovaya-praktika/")}>Открыть раздел <span>→</span></a></article>
    </div>
  </section>
</BaseLayout>
