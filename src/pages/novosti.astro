---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
---

<BaseLayout title="Новости — Управляющий совет" current="Новости">
  <PageHero eyebrow="Регулярное обновление" title="Новости" accent="Управляющего совета" description="Заседания, проекты, опросы, достижения и результаты работы совета в единой новостной ленте." />
  <section class="section content-section">
    <div class="container">
      <div class="category-filter"><span>Все новости</span><span>Заседания</span><span>Проекты</span><span>Опросы</span><span>Достижения</span><span>2026</span></div>
      <div class="editorial-news-grid news-catalog">
        <article class="editorial-news-card editorial-news-featured">
          <PhotoPlaceholder title="Фотография к главной новости" className="editorial-news-image" />
          <div><time>Указать дату публикации</time><h3>Заголовок главной новости Управляющего совета</h3><p>Добавить краткий анонс события, решения или проекта.</p><a class="text-link" href="#">Читать новость <span>→</span></a></div>
        </article>
        {["Заголовок новости о заседании", "Заголовок новости о проекте", "Заголовок публикации о результатах опроса", "Заголовок новости о достижении", "Заголовок новости о принятом решении"].map((title) => (
          <article class="editorial-news-card">
            <PhotoPlaceholder title="Фотография к новости" className="editorial-news-image" />
            <div><time>Указать дату</time><h3>{title}</h3><p>Краткий анонс публикации Управляющего совета.</p><a href="#" aria-label={`Читать: ${title}`}>Читать <span>→</span></a></div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
