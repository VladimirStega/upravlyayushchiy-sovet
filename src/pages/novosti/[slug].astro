---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PhotoPlaceholder from "../../components/PhotoPlaceholder.astro";
import { news, type NewsItem } from "../../data/news";

export function getStaticPaths() {
  return news.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

interface Props { item: NewsItem }
const { item } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const backHref = item.archived ? `${base}/arhiv/` : `${base}/novosti/`;
const backLabel = item.archived ? "Вернуться в архив" : "Вернуться к новостям";
const mediaTitle = item.media === "video" ? "Здесь будет размещён видеоролик" : item.media === "gallery" ? "Здесь будет фотогалерея" : item.media === "none" ? "Публикация без фотографии" : "Здесь будет фотография";
---

<BaseLayout title={`${item.title} — Управляющий совет`} description={item.excerpt} current="Новости">
  <article class="news-article">
    <header class="news-article-header">
      <div class="container news-article-heading">
        <a class="back-link" href={backHref}><span>←</span> {backLabel}</a>
        <div class="news-article-meta">
          <span>{item.categoryLabel}</span>
          <time datetime={item.date}>{item.dateLabel}</time>
        </div>
        <h1>{item.title}</h1>
        <p class="news-article-lead">{item.excerpt}</p>
      </div>
    </header>

    <div class="container news-article-layout">
      <div class="news-article-main">
        {item.media === "video" && item.coverImage ? (
          <div class="news-video-cover">
            <img src={`${base}${item.coverImage.src}`} alt={item.coverImage.alt} />
            <div class="news-video-cover-action">
              <span class="external-video-play" aria-hidden="true">▶</span>
              <strong>{item.mediaLabel}</strong>
              {item.sourceUrl && <a class="button button-primary" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">Посмотреть во ВКонтакте</a>}
            </div>
          </div>
        ) : item.images?.length ? (
          <div class="news-photo-gallery" aria-label={item.mediaLabel}>
            {item.images.map((image, index) => (
              <figure>
                <img src={`${base}${image.src}`} alt={image.alt} loading={index === 0 ? "eager" : "lazy"} />
              </figure>
            ))}
          </div>
        ) : item.coverImage ? (
          <img class="news-article-cover-image" src={`${base}${item.coverImage.src}`} alt={item.coverImage.alt} />
        ) : item.media === "video" ? (
          <div class="photo-placeholder news-article-photo external-video-placeholder">
            <span class="external-video-play" aria-hidden="true">▶</span>
            <strong>{mediaTitle}</strong>
            <small>{item.mediaLabel}</small>
            {item.sourceUrl && <a class="button button-primary" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">Посмотреть во ВКонтакте</a>}
          </div>
        ) : item.media === "none" ? (
          <PhotoPlaceholder title="Публикация без фотографии" note="В исходной публикации ВКонтакте фотография отсутствует." className="news-article-photo" />
        ) : (
          <PhotoPlaceholder title={mediaTitle} note={item.mediaLabel} className="news-article-photo" />
        )}
        <div class="news-article-copy">
          {item.body.map((paragraph) => <p>{paragraph}</p>)}
          {item.sourceUrl && (
            <div class="news-source-note">
              <strong>Источник публикации</strong>
              <p>Полная публикация размещена в официальном сообществе школы во ВКонтакте.</p>
              <a class="text-link" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">Открыть исходную публикацию <span>→</span></a>
            </div>
          )}
        </div>
      </div>

      <aside class="news-article-aside">
        <span>Медиаматериалы</span>
        <h2>{item.images?.length ? "Фотографии мероприятия" : item.media === "video" ? "Видео доступно во ВКонтакте" : item.media === "gallery" ? "Фотогалерея" : item.media === "none" ? "Без фотографии" : "Фотография"}</h2>
        <p>{item.images?.length ? `В галерее размещено ${item.images.length} фотографий из официальной публикации школы.` : item.media === "video" ? "Ролик можно открыть в официальной публикации школы во ВКонтакте." : item.media === "none" ? "В оригинальной публикации ВКонтакте фотография отсутствует." : "Медиаматериалы будут добавлены после получения оригиналов."}</p>
      </aside>
    </div>
  </article>
</BaseLayout>
