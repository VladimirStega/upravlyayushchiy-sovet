---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PhotoPlaceholder from "../../components/PhotoPlaceholder.astro";
import { news, type NewsItem } from "../../data/news";

export function getStaticPaths() {
  return news.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

interface Props { item: NewsItem }
const { item } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const backHref = item.archived ? `${base}/arhiv/` : `${base}/novosti/`;
const backLabel = item.archived ? "Вернуться в архив" : "Вернуться к новостям";
const mediaTitle = item.media === "video" ? "Здесь будет размещён видеоролик" : item.media === "gallery" ? "Здесь будет фотогалерея" : "Здесь будет фотография";
---

<BaseLayout title={`${item.title} — Управляющий совет`} description={item.excerpt} current="Новости">
  <article class="news-article">
    <header class="news-article-header">
      <div class="container news-article-heading">
        <a class="back-link" href={backHref}><span>←</span> {backLabel}</a>
        <div class="news-article-meta">
          <span>{item.categoryLabel}</span>
          <time datetime={item.date}>{item.dateLabel}</time>
        </div>
        <h1>{item.title}</h1>
        <p class="news-article-lead">{item.excerpt}</p>
      </div>
    </header>

    <div class="container news-article-layout">
      <div class="news-article-main">
        {item.media === "video" ? (
          <div class="photo-placeholder news-article-photo external-video-placeholder">
            <span class="external-video-play" aria-hidden="true">▶</span>
            <strong>{mediaTitle}</strong>
            <small>{item.mediaLabel}</small>
            <a class="button button-primary" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">Посмотреть во ВКонтакте</a>
          </div>
        ) : (
          <PhotoPlaceholder title={mediaTitle} note={item.mediaLabel} className="news-article-photo" />
        )}
        <div class="news-article-copy">
          {item.body.map((paragraph) => <p>{paragraph}</p>)}
          <div class="news-source-note">
            <strong>Источник публикации</strong>
            <p>Полная публикация размещена в официальном сообществе школы во ВКонтакте.</p>
            <a class="text-link" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">Открыть исходную публикацию <span>→</span></a>
          </div>
        </div>
      </div>

      <aside class="news-article-aside">
        <span>Медиаматериалы</span>
        <h2>{item.media === "video" ? "Видео доступно во ВКонтакте" : item.media === "gallery" ? "Нужны оригиналы фотографий" : "Нужна оригинальная фотография"}</h2>
        <p>{item.media === "video" ? "Ролик остаётся в исходной публикации: посетитель сможет открыть его по кнопке, поэтому загружать MP4 на сайт не требуется." : "Скриншот публикации используется только как источник информации и не будет размещён на сайте."}</p>
        <ul>
          <li>{item.media === "video" ? "При желании можно добавить отдельную обложку" : "Файлы JPG или PNG без интерфейса ВК"}</li>
          <li>Краткая подпись к материалам</li>
          <li>При необходимости — имя автора</li>
        </ul>
      </aside>
    </div>
  </article>
</BaseLayout>
