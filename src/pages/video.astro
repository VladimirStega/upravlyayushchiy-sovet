---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout title="Видео — Управляющий совет">
  <PageHero
    eyebrow="Видеовизитка"
    title="Видео о"
    accent="работе совета"
    description="Короткий рассказ о составе, принципах работы, проектах и результатах Управляющего совета школы."
  />

  <section class="section content-section">
    <div class="container video-grid">
      <div class="video-placeholder video-placeholder-pending">
        <div class="video-screen">
          <span class="video-play-placeholder" aria-hidden="true">▶</span>
          <strong>Видеовизитка готовится к публикации</strong>
          <small>После загрузки здесь появится ролик в формате 16:9</small>
        </div>
      </div>
      <div class="video-copy">
        <p class="eyebrow eyebrow-dark"><span></span> Скоро на сайте</p>
        <h2>Пять минут<br /><em>о главном</em></h2>
        <p>В ролике будут представлены участники совета, порядок принятия решений, реализованные проекты и планы дальнейшей работы.</p>
        <p class="video-accessibility-note">Вместе с видео будет опубликована текстовая расшифровка.</p>
      </div>
    </div>
  </section>
</BaseLayout>
