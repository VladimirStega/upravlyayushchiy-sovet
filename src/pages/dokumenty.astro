---

<BaseLayout title="Документы — Управляющий совет" current="Документы">
  <PageHero eyebrow="Открытая документация" title="Документы и" accent="отчётность" description="Нормативные документы, планы, протоколы, отчёты и материалы комиссий с фильтрацией по категориям и учебным годам." />
  <section class="section content-section document-library-section">
    <div class="container">
      <div class="page-section-heading"><div><p class="eyebrow eyebrow-dark"><span></span> Открытая библиотека</p><h2>Все <em>документы</em></h2></div><p>Официальные материалы Управляющего совета доступны для просмотра и скачивания.</p></div>
      <div class="document-toolbar">
        <label class="document-search">
          <span class="sr-only">Поиск по названию документа</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m16 16 5 5"></path></svg>
          <input type="search" placeholder="Найти документ" data-document-search />
        </label>
        <div class="category-filter document-filter-chips" aria-label="Категории документов">
          {documentCategories.map(([key, label], index) => (
            <button class:list={{ active: index === 0 }} type="button" data-document-filter={key} aria-pressed={index === 0 ? "true" : "false"}>{label}</button>
          ))}
        </div>
      </div>
      <div class="document-list standalone-documents">
        {documents.map(({ category, title, meta, href }) => (
          <a href={href} data-document-category={category} data-document-title={`${title} ${meta}`.toLowerCase()} target="_blank" rel="noopener">
            <span class="file-icon">{href.endsWith(".pptx") ? "PPTX" : "PDF"}</span>
            <span><strong>{title}</strong><small>{meta}</small></span>
            <i aria-hidden="true">↗</i>
          </a>
        ))}
      </div>
      <p class="document-empty" data-document-empty hidden>В этой категории документы пока не опубликованы.</p>
    </div>
  </section>

  <script>
    const setupDocumentFilters = () => {
      const buttons = document.querySelectorAll("[data-document-filter]");
      const documents = document.querySelectorAll("[data-document-category]");
      const emptyState = document.querySelector("[data-document-empty]");
      const search = document.querySelector("[data-document-search]");
      let activeFilter = "all";

      const updateDocuments = () => {
        const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : "";
        let visibleCount = 0;
        documents.forEach((documentItem) => {
          const matchesCategory = activeFilter === "all" || documentItem.getAttribute("data-document-category") === activeFilter;
          const matchesSearch = !query || (documentItem.getAttribute("data-document-title") || "").includes(query);
          const visible = matchesCategory && matchesSearch;
          documentItem.toggleAttribute("hidden", !visible);
          if (visible) visibleCount += 1;
        });
        emptyState?.toggleAttribute("hidden", visibleCount > 0);
      };

      buttons.forEach((button) => {
        if (!(button instanceof HTMLElement) || button.dataset.bound) return;
        button.dataset.bound = "true";
        button.addEventListener("click", () => {
          activeFilter = button.getAttribute("data-document-filter") || "all";
          buttons.forEach((item) => {
            const selected = item === button;
            item.classList.toggle("active", selected);
            item.setAttribute("aria-pressed", String(selected));
          });
          updateDocuments();
        });
      });

      if (search instanceof HTMLInputElement && !search.dataset.bound) {
        search.dataset.bound = "true";
        search.addEventListener("input", updateDocuments);
      }
    };
    document.addEventListener("astro:page-load", setupDocumentFilters);
  </script>
</BaseLayout>
