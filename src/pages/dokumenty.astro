---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const documents = [
  {
    category: "normative",
    title: "Положение об Управляющем совете",
    meta: "Согласовано 29 августа 2025 года · изменения от 29 сентября 2025 года · PDF · 3,5 МБ",
    href: `${base}/documents/polozhenie-ob-upravlyayushchem-sovete.pdf`
  },
  {
    category: "elections",
    title: "Состав Управляющего совета на 2025–2026 учебный год",
    meta: "Утверждён приказом от 1 сентября 2025 года № 159 · PDF · 411 КБ",
    href: `${base}/documents/sostav-upravlyayushchego-soveta-2025-2026.pdf`
  },
  {
    category: "elections",
    title: "Положение о выборах в Управляющий совет",
    meta: "Согласовано 26 февраля 2026 года · PDF · 1,4 МБ",
    href: `${base}/documents/polozhenie-o-vyborah-v-upravlyayushchiy-sovet.pdf`
  },
  {
    category: "plans",
    title: "План работы Управляющего совета на 2025–2026 учебный год",
    meta: "План заседаний и основных направлений работы · PDF · 384 КБ",
    href: `${base}/documents/plan-raboty-us-2025-2026.pdf`
  },
  {
    category: "protocols",
    title: "Протокол заседания № 1",
    meta: "28 августа 2025 года · PDF · 5,3 МБ",
    href: `${base}/documents/protokol-us-1-2025-08-28.pdf`
  },
  {
    category: "protocols",
    title: "Протокол заседания № 2",
    meta: "22 октября 2025 года · PDF · 5,5 МБ",
    href: `${base}/documents/protokol-us-2-2025-10-22.pdf`
  },
  {
    category: "protocols",
    title: "Протокол заседания № 3",
    meta: "24 декабря 2025 года · PDF · 6,1 МБ",
    href: `${base}/documents/protokol-us-3-2025-12-24.pdf`
  },
  {
    category: "protocols",
    title: "Протокол заседания № 4",
    meta: "26 марта 2026 года · PDF · 4,2 МБ",
    href: `${base}/documents/protokol-us-4-2026-03-26.pdf`
  },
  {
    category: "protocols",
    title: "Протокол заседания № 5",
    meta: "20 мая 2026 года · PDF · 7,4 МБ",
    href: `${base}/documents/protokol-us-5-2026-05-20.pdf`
  },
  {
    category: "reports",
    title: "Отчёт о деятельности Управляющего совета за 2025–2026 учебный год",
    meta: "Итоги работы совета · PDF · 1,7 МБ",
    href: `${base}/documents/otchet-o-deyatelnosti-us-2025-2026.pdf`
  },
  {
    category: "reports",
    title: "Результаты опроса, проведённого Управляющим советом",
    meta: "Апрель 2026 года · PDF · 619 КБ",
    href: `${base}/documents/rezultaty-oprosa-us-2026.pdf`
  },
  {
    category: "projects",
    title: "Основные направления деятельности и проекты Управляющего совета",
    meta: "Сводный материал · PDF · 372 КБ",
    href: `${base}/documents/projects/napravleniya-i-proekty-us.pdf`
  },
  {
    category: "projects",
    title: "Проект «Родители и дети: играем в старину, живём в современности»",
    meta: "Презентация проекта · PPTX · 21,1 МБ",
    href: `${base}/documents/projects/roditeli-i-deti.pptx`
  },
  {
    category: "projects",
    title: "Проект «Окна воспоминаний»",
    meta: "Описание проекта · PDF · 1,2 МБ",
    href: `${base}/documents/projects/okna-vospominaniy.pdf`
  },
  {
    category: "projects",
    title: "Практика «Человек и деятельность»",
    meta: "Материалы по трудовому воспитанию и профессиональному самоопределению · PDF · 1,5 МБ",
    href: `${base}/documents/projects/chelovek-i-deyatelnost.pdf`
  }
];
---

<BaseLayout title="Документы — Управляющий совет" current="Документы">
  <PageHero eyebrow="Открытая документация" title="Документы и" accent="отчётность" description="Нормативные документы, планы, протоколы, отчёты и материалы комиссий с фильтрацией по категориям и учебным годам." />
  <section class="section content-section">
    <div class="container">
      <div class="document-filter-heading">
        <div><p class="eyebrow eyebrow-dark"><span></span> Фильтр документов</p><h2>Выберите <em>категорию</em></h2></div>
        <button class="document-filter-reset active" type="button" data-document-filter="all" aria-pressed="true">Все документы</button>
      </div>
      <div class="document-category-grid">
        {[
          ["normative", "Нормативная база", "Устав, Положение об УС, регламенты и локальные акты"],
          ["plans", "Планы работы", "Текущий план и планы прошлых учебных лет"],
          ["protocols", "Протоколы", "Протоколы заседаний и публичные выписки"],
          ["reports", "Отчёты", "Годовые отчёты совета и комиссий"],
          ["elections", "Состав и выборы", "Приказы, результаты выборов и утверждённый состав"],
          ["projects", "Проектные документы", "Решения о поддержке и подтверждающие материалы"],
          ["training", "Обучение и стажировки", "Повышение квалификации и стажировки членов совета"],
          ["archive", "Архив", "Документы прошлых учебных лет"]
        ].map(([key, title, text]) => (
          <button class="document-category" type="button" data-document-filter={key} aria-pressed="false"><h3>{title}</h3><p>{text}</p><span>Показать документы →</span></button>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="page-section-heading"><h2>Последние <em>документы</em></h2><p>Официальные документы Управляющего совета доступны для просмотра и скачивания в формате PDF.</p></div>
      <div class="document-list standalone-documents">
        {documents.map(({ category, title, meta, href }) => (
          <a href={href} data-document-category={category} target="_blank" rel="noopener">
            <span class="file-icon">PDF</span>
            <span><strong>{title}</strong><small>{meta}</small></span>
            <i aria-hidden="true">↓</i>
          </a>
        ))}
      </div>
      <p class="document-empty" data-document-empty hidden>В этой категории документы пока не опубликованы.</p>
    </div>
  </section>

  <script>
    const setupDocumentFilters = () => {
      const buttons = document.querySelectorAll("[data-document-filter]");
      const documents = document.querySelectorAll("[data-document-category]");
      const emptyState = document.querySelector("[data-document-empty]");
      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const filter = button.getAttribute("data-document-filter") || "all";
          let visibleCount = 0;
          buttons.forEach((item) => {
            const selected = item === button;
            item.classList.toggle("active", selected);
            item.setAttribute("aria-pressed", String(selected));
          });
          documents.forEach((documentItem) => {
            const visible = filter === "all" || documentItem.getAttribute("data-document-category") === filter;
            documentItem.toggleAttribute("hidden", !visible);
            if (visible) visibleCount += 1;
          });
          emptyState?.toggleAttribute("hidden", visibleCount > 0);
        });
      });
    };
    document.addEventListener("astro:page-load", setupDocumentFilters);
  </script>
</BaseLayout>
