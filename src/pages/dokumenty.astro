---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout title="Документы — Управляющий совет" current="Документы">
  <PageHero eyebrow="Открытая документация" title="Документы и" accent="отчётность" description="Нормативные документы, планы, протоколы, отчёты и материалы комиссий с фильтрацией по категориям и учебным годам." />
  <section class="section content-section">
    <div class="container">
      <div class="document-category-grid">
        {[
          ["01", "Нормативная база", "Устав, Положение об УС, регламенты и локальные акты"],
          ["02", "Планы работы", "Текущий план и планы прошлых учебных лет"],
          ["03", "Протоколы", "Протоколы заседаний и публичные выписки"],
          ["04", "Отчёты", "Годовые отчёты совета и комиссий"],
          ["05", "Состав и выборы", "Приказы, результаты выборов и утверждённый состав"],
          ["06", "Проектные документы", "Решения о поддержке и подтверждающие материалы"],
          ["07", "Материалы комиссий", "Планы, заключения и рабочие документы"],
          ["08", "Архив", "Документы прошлых учебных лет"]
        ].map(([number, title, text]) => (
          <article class="document-category"><span>{number}</span><h3>{title}</h3><p>{text}</p></article>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="page-section-heading"><h2>Последние <em>документы</em></h2><p>После загрузки появятся реальные даты, размеры файлов и кнопки просмотра или скачивания.</p></div>
      <div class="document-list standalone-documents">
        {["Положение об Управляющем совете", "План работы на 2026/27 учебный год", "Протокол последнего заседания", "Годовой отчёт Управляющего совета"].map((title) => (
          <a href="#"><span class="file-icon">PDF</span><span><strong>{title}</strong><small>Загрузить актуальный документ · PDF · указать размер</small></span><i>↓</i></a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
