    meta: "Утверждён приказом от 1 сентября 2025 года № 159 · PDF · 90 КБ",
    href: `${base}/documents/sostav-upravlyayushchego-soveta-2025-2026.pdf`
  },
  {
    category: "elections",
    title: "Положение о выборах в Управляющий совет",
    meta: "Согласовано 26 февраля 2026 года · PDF · 1,4 МБ",
    href: `${base}/documents/polozhenie-o-vyborah-v-upravlyayushchiy-sovet.pdf`
  },
  {
    category: "plans",
    title: "План работы Управляющего совета на 2025–2026 учебный год",
    meta: "План заседаний и основных направлений работы · PDF · 384 КБ",
    href: `${base}/documents/plan-raboty-us-2025-2026.pdf`
  },
  {
    category: "protocols",
    title: "Протокол заседания № 1",
    meta: "28 августа 2025 года · PDF · 5,3 МБ",
    href: `${base}/documents/protokol-us-1-2025-08-28.pdf`
  },
  {
    category: "protocols",
    title: "Протокол заседания № 2",
    meta: "22 октября 2025 года · PDF · 5,5 МБ",
    href: `${base}/documents/protokol-us-2-2025-10-22.pdf`
  },
  {
    category: "protocols",
    title: "Протокол заседания № 3",
    meta: "24 декабря 2025 года · PDF · 6,1 МБ",
    href: `${base}/documents/protokol-us-3-2025-12-24.pdf`
  },
  {
    category: "protocols",
    title: "Протокол заседания № 4",
    meta: "26 марта 2026 года · PDF · 4,2 МБ",
    href: `${base}/documents/protokol-us-4-2026-03-26.pdf`
  },
  {
    category: "protocols",
