---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
const publications = [
  {
    title: "Управляющий совет школы № 47: состав, работа и инициативы",
    description: "Материал о работе совета и участии родителей, учеников и педагогов в жизни школы. Представлены проекты «Труд не уходит на каникулы», «Родители и дети: играем в старину, живём в современности» и «Родительский патруль».",
    url: "https://iom48.ru/prosveshhenie-roditelej-doshkolnikov/"
  }
];
---
<BaseLayout title="Публикации в СМИ — Управляющий совет" description="Публикации о деятельности Управляющего совета школы № 47, проектах и совместных инициативах.">
  <PageHero eyebrow="О нашей работе" title="Публикации" accent="в СМИ" description="Материалы о деятельности Управляющего совета, наших проектах и совместных инициативах." />
  <section class="section content-section press-section">
    <div class="container press-grid">
      {publications.map((item) => (
        <article class="press-card">
          <p class="press-source">ИРО Липецкой области · iom48.ru</p>
          <h2><a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}</a></h2>
          <p class="press-description">{item.description}</p>
          <a class="press-link" href={item.url} target="_blank" rel="noopener noreferrer">Читать публикацию <span aria-hidden="true">↗</span><span class="sr-only"> — {item.title}</span></a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
<style>
  .press-section { position: relative; z-index: 2; }
  .press-grid { display: grid; grid-template-columns: minmax(0, 1fr); max-width: 960px; gap: 28px; }
  .press-card { display: flex; flex-direction: column; padding: clamp(24px, 3vw, 40px); border: 1px solid #dce5ed; border-radius: 20px; background: #fff; box-shadow: 0 8px 28px rgba(22,59,98,.04); }
  .press-source { margin: 0 0 20px; color: #52677c; font-size: 14px; }
  .press-card h2 { margin: 0 0 20px; font-size: clamp(23px, 2vw, 30px); line-height: 1.3; }
  .press-card h2 a { color: #163b62; text-decoration: none; }
  .press-card h2 a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .press-description { color: #40566d; line-height: 1.7; }
  .press-link { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: auto; padding-top: 20px; border-top: 1px solid #e6edf3; color: #174a8b; font-weight: 700; text-decoration: none; }
  .press-link:hover { text-decoration: underline; }
  @media (max-width: 760px) { .press-grid { grid-template-columns: 1fr; } }
</style>
