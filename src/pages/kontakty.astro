---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout title="Контакты — Управляющий совет" current="Контакты">
  <PageHero eyebrow="Обратная связь" title="Связаться" accent="с советом" description="Контакты, часы приёма и будущая форма для вопросов, предложений и инициатив." />
  <section class="section content-section">
    <div class="container contact-layout">
      <article class="contact-panel"><p class="eyebrow eyebrow-dark"><span></span> Контакты</p><h2>Мы открыты<br /><em>для диалога</em></h2><dl><dt>Телефон</dt><dd>+7 (___) ___-__-__</dd><dt>Электронная почта</dt><dd>совет@example.ru</dd><dt>Адрес</dt><dd>Адрес образовательной организации</dd><dt>Часы приёма</dt><dd>Указать день и время</dd></dl></article>
      <article class="form-placeholder"><p class="eyebrow eyebrow-dark"><span></span> Форма обращения</p><h2>Предложить инициативу</h2><div class="fake-field">Поле: имя заявителя</div><div class="fake-field">Поле: электронная почта или телефон</div><div class="fake-field">Поле: тема обращения</div><div class="fake-field large">Поле: текст обращения</div><p>Перед запуском формы необходимо добавить согласие на обработку персональных данных и адрес получателя.</p><span class="button button-primary">Отправить обращение</span></article>
    </div>
  </section>
</BaseLayout>
