---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="Видеовизитка — Управляющий совет">
  <section class="section alias-page">
    <div class="container alias-card">
      <p class="eyebrow eyebrow-dark"><span></span> Раздел объединён</p>
      <h1>Видеовизитка находится<br />в разделе «Видео»</h1>
      <p>Мы объединили видеоматериалы на одной странице, чтобы их было проще находить.</p>
      <a class="button button-primary" href={`${base}/video/`}>Перейти к видео</a>
    </div>
  </section>
</BaseLayout>
