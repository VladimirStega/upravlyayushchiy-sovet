---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
---

<BaseLayout title="Достижения и медиа — Управляющий совет" current="Достижения и медиа">
  <PageHero eyebrow="Подтверждённые результаты" title="Достижения" accent="и медиа" description="Награды, благодарности, выступления, публикации в СМИ, повышение квалификации и стажировки членов совета." />
  <section class="section content-section">
    <div class="container content-grid">
      <article class="content-card"><PhotoPlaceholder title="Скан диплома или фотография награды" /><h3>Награды Управляющего совета</h3><p>Добавить дипломы, грамоты, кубки и краткое описание достижения.</p></article>
      <article class="content-card"><PhotoPlaceholder title="Скан благодарственного письма" /><h3>Благодарности</h3><p>Добавить письма от органов власти, общественных и коммерческих организаций.</p></article>
      <article class="content-card"><PhotoPlaceholder title="Обложка или скриншот публикации" /><h3>Публикации и выступления</h3><p>Добавить ссылки на федеральные, региональные и муниципальные материалы.</p></article>
    </div>
  </section>
  <section class="section">
    <div class="container content-grid two-columns">
      <article class="content-card dark"><span class="content-card-number">Повышение квалификации</span><h2>Документы членов совета</h2><p>Разместить разрешённые к публикации подтверждения за последние три года и показать долю обученных участников.</p></article>
      <article class="content-card accent"><span class="content-card-number">Стажировки НАВУСОО</span><h2>Федеральные стажировочные площадки</h2><p>Добавить документы о прохождении стажировок и краткие итоги полученного опыта.</p></article>
    </div>
  </section>
</BaseLayout>
