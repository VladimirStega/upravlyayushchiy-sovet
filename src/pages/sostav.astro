---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CouncilStructureDiagram from "../components/CouncilStructureDiagram.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const members = [
  ["parents", "Председатель Управляющего совета", "Заваленкова Татьяна Валерьевна", "Родитель (законный представитель) · начальник отдела снабжения АО «Экопром – Липецк»", true, "/images/members/cutouts/zavalenkova-tatyana-valerevna.webp", "50% 28%"],
  ["parents", "Заместитель председателя", "Баева Кристина Александровна", "Родитель (законный представитель) · старший педагог ГБУ ДО «Центр дополнительного образования Липецкой области»", false, "/images/members/cutouts/baeva-kristina-aleksandrovna.webp", "50% 28%"],
  ["employees", "Секретарь Управляющего совета", "Битуева Наталья Викторовна", "Работник образовательной организации · заместитель директора", false, "/images/members/cutouts/bitueva-natalya-viktorovna.webp", "50% 27%"],
  ["employees", "Член Управляющего совета", "Катасонов Игорь Александрович", "Руководитель образовательной организации · директор МБОУ СОШ № 47 г. Липецка", false, "/images/members/cutouts/katasonov-igor-aleksandrovich.webp", "50% 28%"],
  ["founder", "Член Управляющего совета", "Ермошина Антонина Николаевна", "Представитель учредителя · заместитель начальника отдела развития образования департамента образования администрации города Липецка", false, "/images/members/cutouts/ermoshina-antonina-nikolaevna.webp", "50% 25%"],
  ["employees", "Член Управляющего совета", "Иванова Виктория Александровна", "Работник образовательной организации · советник по воспитанию", false, "", "50% 28%"],
  ["employees", "Член Управляющего совета", "Телегина Светлана Анатольевна", "Работник образовательной организации · учитель начальных классов", false, "/images/members/cutouts/telegina-svetlana-anatolevna.webp", "50% 27%"],
  ["parents", "Член Управляющего совета", "Зуфарова Регина Равильевна", "Родитель (законный представитель) · ведущий бухгалтер ДОУ № 66", false, "/images/members/cutouts/zufarova-regina-ravilevna.webp", "50% 27%"],
  ["students", "Член Управляющего совета", "Овчинников Константин Олегович", "Представитель обучающихся МБОУ СОШ № 47", false, "/images/members/cutouts/ovchinnikov-konstantin-olegovich.webp", "50% 25%"],
  ["students", "Член Управляющего совета", "Смородина Александра Сергеевна", "Представитель обучающихся МБОУ СОШ № 47", false, "/images/members/cutouts/smorodina-aleksandra-sergeevna.webp", "50% 24%"],
  ["students", "Член Управляющего совета", "Коретник Светлана Александровна", "Представитель обучающихся МБОУ СОШ № 47", false, "/images/members/cutouts/koretnik-svetlana-aleksandrovna.webp", "50% 25%"],
  ["graduates", "Член Управляющего совета", "Коновалов Егор", "Выпускник МБОУ СОШ № 47 · студент Липецкого филиала ВЭПИ · член совета выпускников", false, "/images/members/konovalov-egor.png", "50% 28%"],
  ["coopted", "Член Управляющего совета", "Корнаухов Александр Сергеевич", "Кооптированный член · депутат Липецкого городского Совета депутатов, генеральный директор строительной компании «Палантир ТБ»", false, "/images/members/cutouts/kornaukhov-aleksandr-sergeevich.webp", "50% 28%"],
  ["coopted", "Член Управляющего совета", "Стеганцев Владимир Сергеевич", "Кооптированный член · помощник депутата городского совета депутатов 7-го созыва по 23 избирательному округу", false, "/images/members/cutouts/stegantsev-vladimir-sergeevich.webp", "50% 28%"]
];
---

<BaseLayout title="Состав и структура — Управляющий совет" current="Состав">
  <PageHero
    eyebrow="Люди совета"
    title="Состав и"
    accent="структура"
    description="Полный состав Управляющего совета с категориями участников, ролями, комиссиями и сроками полномочий."
  />

  <section class="section content-section">
    <div class="container">
      <div class="page-section-heading">
        <div><p class="eyebrow eyebrow-dark"><span></span> Текущий состав</p><h2>Представители <em>всего сообщества</em></h2></div>
        <p>Состав на 2026–2027 учебный год утверждён приказом директора МБОУ СОШ № 47 от 10 сентября 2026 года № 249.</p>
      </div>
      <p class="composition-document"><a href={`${base}/documents/sostav-us.pdf`} target="_blank" rel="noopener">Открыть утверждённый состав на 2026–2027 учебный год · PDF ↗</a></p>
      <div class="category-filter" aria-label="Фильтр состава">
        <button class="active" type="button" data-member-filter="all" aria-pressed="true">Все участники</button>
        <button type="button" data-member-filter="parents" aria-pressed="false">Родители</button>
        <button type="button" data-member-filter="students" aria-pressed="false">Обучающиеся</button>
        <button type="button" data-member-filter="graduates" aria-pressed="false">Выпускники</button>
        <button type="button" data-member-filter="employees" aria-pressed="false">Работники</button>
        <button type="button" data-member-filter="founder" aria-pressed="false">Представитель учредителя</button>
        <button type="button" data-member-filter="coopted" aria-pressed="false">Кооптированные члены</button>
      </div>
      <div class="member-directory">
        {members.map(([category, role, name, description, featured, photo, photoPosition]) => (
          <article class:list={["person-card", { "person-card-featured": featured }]} data-member-category={category}>
            {photo ? (
              <img class="person-photo person-photo-image" src={`${base}${photo}`} alt={`Фотография: ${name}`} loading="lazy" style={`object-position: ${photoPosition}`} />
            ) : (
              <div class="photo-placeholder person-photo">
                <span class="placeholder-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="17" r="9"></circle><path d="M8 43c1-11 7-17 16-17s15 6 16 17"></path></svg></span>
                <strong>Фотография участника УС</strong>
              </div>
            )}
            <div class="person-info"><span>{role}</span><h3>{name}</h3><p>{description}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CouncilStructureDiagram />

  <script>
    const setupMemberFilters = () => {
      const buttons = document.querySelectorAll("[data-member-filter]");
      const members = document.querySelectorAll("[data-member-category]");
      buttons.forEach((button) => {
        if (!(button instanceof HTMLElement) || button.dataset.bound) return;
        button.dataset.bound = "true";
        button.addEventListener("click", () => {
          const filter = button.getAttribute("data-member-filter") || "all";
          buttons.forEach((item) => {
            const selected = item === button;
            item.classList.toggle("active", selected);
            item.setAttribute("aria-pressed", String(selected));
          });
          members.forEach((member) => {
            const visible = filter === "all" || member.getAttribute("data-member-category") === filter;
            member.toggleAttribute("hidden", !visible);
          });
        });
      });
    };
    document.addEventListener("astro:page-load", setupMemberFilters);
  </script>
</BaseLayout>

<style>
  .composition-document { margin: 0 0 24px; }
  .composition-document a { font-weight: 600; text-underline-offset: 4px; }
</style>
