---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";

const members = [
  ["parents", "Председатель Управляющего совета", "Заваленкова Татьяна Валерьевна", "Родитель (законный представитель) · начальник отдела снабжения АО «Экопром – Липецк»", true],
  ["parents", "Заместитель председателя", "Баева Кристина Александровна", "Родитель (законный представитель) · старший педагог ГБУ ДО «Центр дополнительного образования Липецкой области»", false],
  ["employees", "Секретарь Управляющего совета", "Битуева Наталья Викторовна", "Работник образовательной организации · заместитель директора", false],
  ["employees", "Член Управляющего совета", "Катасонов Игорь Александрович", "Руководитель образовательной организации · директор МБОУ СОШ № 47 г. Липецка", false],
  ["all", "Член Управляющего совета", "Терехова Марианна Михайловна", "Заместитель начальника отдела дополнительного образования, воспитания и оздоровления департамента образования администрации г. Липецка", false],
  ["employees", "Член Управляющего совета", "Ушакова Кристина Сергеевна", "Работник образовательной организации · заместитель директора", false],
  ["employees", "Член Управляющего совета", "Телегина Светлана Анатольевна", "Работник образовательной организации · учитель начальных классов", false],
  ["parents", "Член Управляющего совета", "Зуфарова Регина Равильевна", "Родитель (законный представитель) · ведущий бухгалтер ДОУ № 66", false],
  ["students", "Член Управляющего совета", "Овчинников Константин Олегович", "Представитель обучающихся МБОУ СОШ № 47", false],
  ["students", "Член Управляющего совета", "Смородина Александра Сергеевна", "Представитель обучающихся МБОУ СОШ № 47", false],
  ["students", "Член Управляющего совета", "Коретник Светлана Александровна", "Представитель обучающихся МБОУ СОШ № 47", false],
  ["coopted", "Член Управляющего совета", "Корноухов Александр Сергеевич", "Кооптированный член · депутат Липецкого городского Совета депутатов, генеральный директор строительной компании «Палантир ТБ»", false]
];
---

<BaseLayout title="Состав и структура — Управляющий совет" current="Состав">
  <PageHero
    eyebrow="Люди совета"
    title="Состав и"
    accent="структура"
    description="Полный состав Управляющего совета с категориями участников, ролями, комиссиями и сроками полномочий."
  />

  <section class="section content-section">
    <div class="container">
      <div class="page-section-heading">
        <div><p class="eyebrow eyebrow-dark"><span></span> Текущий состав</p><h2>Представители <em>всего сообщества</em></h2></div>
        <p>Состав утверждён приказом директора МБОУ СОШ № 47 от 1 сентября 2025 года № 159 на 2025–2026 учебный год.</p>
      </div>
      <div class="category-filter" aria-label="Фильтр состава">
        <button class="active" type="button" data-member-filter="all" aria-pressed="true">Все участники</button>
        <button type="button" data-member-filter="parents" aria-pressed="false">Родители</button>
        <button type="button" data-member-filter="students" aria-pressed="false">Обучающиеся</button>
        <button type="button" data-member-filter="employees" aria-pressed="false">Работники</button>
        <button type="button" data-member-filter="coopted" aria-pressed="false">Кооптированный член</button>
      </div>
      <div class="member-directory">
        {members.map(([category, role, name, description, featured]) => (
          <article class:list={["person-card", { "person-card-featured": featured }]} data-member-category={category}>
            <div class="photo-placeholder person-photo">
              <span class="placeholder-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="17" r="9"></circle><path d="M8 43c1-11 7-17 16-17s15 6 16 17"></path></svg></span>
              <strong>Фотография участника УС</strong>
            </div>
            <div class="person-info"><span>{role}</span><h3>{name}</h3><p>{description}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="page-section-heading"><div><p class="eyebrow eyebrow-dark"><span></span> Организация работы</p><h2>Кто за что <em>отвечает</em></h2></div><p>Руководство совета указано в соответствии с утверждённым составом на 2025–2026 учебный год.</p></div>
      <div class="structure-leadership">
        {[
          ["Председатель совета", "Заваленкова Татьяна Валерьевна", "Координирует работу совета, ведёт заседания и представляет принятые решения."],
          ["Заместитель председателя", "Баева Кристина Александровна", "Помогает организовывать работу и замещает председателя при необходимости."],
          ["Секретарь совета", "Битуева Наталья Викторовна", "Готовит материалы заседаний, ведёт протоколы и контролирует публикацию документов."]
        ].map(([role, name, description]) => (
          <article class="structure-person-card">
            <div class="photo-placeholder structure-person-photo">
              <span class="placeholder-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="17" r="9"></circle><path d="M8 43c1-11 7-17 16-17s15 6 16 17"></path></svg></span>
              <strong>Фотография участника УС</strong>
            </div>
            <div><h3>{role}</h3><strong>{name}</strong><p>{description}</p></div>
          </article>
        ))}
      </div>
      <div class="structure-commissions-heading">
        <h3>Комиссии и рабочие группы</h3>
        <p>Комиссии и их руководители определены на первом заседании Управляющего совета в 2025–2026 учебном году.</p>
      </div>
      <div class="structure-commissions">
        {[
          ["По контролю за организацией питания и качеством образования", "Баева Кристина Александровна", "Рассматривает вопросы организации школьного питания, условий обучения и качества образования."],
          ["По вопросам безопасности и охране труда", "Телегина Светлана Анатольевна", "Рассматривает вопросы безопасных условий, охраны труда и комфортной школьной среды."],
          ["По финансово-экономическому контролю и развитию материально-технической базы", "Зуфарова Регина Равильевна", "Рассматривает вопросы использования ресурсов и развития материально-технической базы школы."]
        ].map(([title, leader, description]) => (
          <article class="commission-card">
            <div class="photo-placeholder commission-photo"><strong>Фотография руководителя комиссии</strong></div>
            <div><h3>{title}</h3><strong>{leader}</strong><p>{description}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <script>
    const setupMemberFilters = () => {
      const buttons = document.querySelectorAll("[data-member-filter]");
      const members = document.querySelectorAll("[data-member-category]");
      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const filter = button.getAttribute("data-member-filter") || "all";
          buttons.forEach((item) => {
            const selected = item === button;
            item.classList.toggle("active", selected);
            item.setAttribute("aria-pressed", String(selected));
          });
          members.forEach((member) => {
            const visible = filter === "all" || member.getAttribute("data-member-category") === filter;
            member.toggleAttribute("hidden", !visible);
          });
        });
      });
    };
    document.addEventListener("astro:page-load", setupMemberFilters);
  </script>
</BaseLayout>
