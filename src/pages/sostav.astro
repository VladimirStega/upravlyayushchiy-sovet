---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CouncilStructureDiagram from "../components/CouncilStructureDiagram.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const members = [
  ["parents", "Председатель Управляющего совета", "Заваленкова Татьяна Валерьевна", "Родитель (законный представитель) · начальник отдела снабжения АО «Экопром – Липецк»", true, "/images/members/zavalenkova-tatyana-valerevna.jpg"],
  ["parents", "Заместитель председателя", "Баева Кристина Александровна", "Родитель (законный представитель) · старший педагог ГБУ ДО «Центр дополнительного образования Липецкой области»", false, "/images/members/baeva-kristina-aleksandrovna.jpg"],
  ["employees", "Секретарь Управляющего совета", "Битуева Наталья Викторовна", "Работник образовательной организации · заместитель директора", false, "/images/members/bitueva-natalya-viktorovna.jpg"],
  ["employees", "Член Управляющего совета", "Катасонов Игорь Александрович", "Руководитель образовательной организации · директор МБОУ СОШ № 47 г. Липецка", false, "/images/members/katasonov-igor-aleksandrovich.jpg"],
  ["founder", "Член Управляющего совета", "Ермошина Антонина Николаевна", "Представитель учредителя · заместитель начальника отдела развития образования департамента образования администрации города Липецка", false, "/images/members/ermoshina-antonina-nikolaevna.jpg"],
  ["employees", "Член Управляющего совета", "Ушакова Кристина Сергеевна", "Работник образовательной организации · советник по воспитанию", false, "/images/members/ushakova-kristina-sergeevna.jpg"],
  ["employees", "Член Управляющего совета", "Телегина Светлана Анатольевна", "Работник образовательной организации · учитель начальных классов", false, "/images/members/telegina-svetlana-anatolevna.jpg"],
  ["parents", "Член Управляющего совета", "Зуфарова Регина Равильевна", "Родитель (законный представитель) · ведущий бухгалтер ДОУ № 66", false, "/images/members/zufarova-regina-ravilevna.jpg"],
  ["students", "Член Управляющего совета", "Овчинников Константин Олегович", "Представитель обучающихся МБОУ СОШ № 47", false, "/images/members/ovchinnikov-konstantin-olegovich.jpg"],
  ["students", "Член Управляющего совета", "Смородина Александра Сергеевна", "Представитель обучающихся МБОУ СОШ № 47", false, "/images/members/smorodina-aleksandra-sergeevna.jpg"],
  ["students", "Член Управляющего совета", "Коретник Светлана Александровна", "Представитель обучающихся МБОУ СОШ № 47", false, "/images/members/koretnik-svetlana-aleksandrovna.jpg"],
  ["coopted", "Член Управляющего совета", "Корнаухов Александр Сергеевич", "Кооптированный член · депутат Липецкого городского Совета депутатов, генеральный директор строительной компании «Палантир ТБ»", false, "/images/members/kornaukhov-aleksandr-sergeevich.jpg"]
];
---

<BaseLayout title="Состав и структура — Управляющий совет" current="Состав">
  <PageHero
    eyebrow="Люди совета"
    title="Состав и"
    accent="структура"
    description="Полный состав Управляющего совета с категориями участников, ролями, комиссиями и сроками полномочий."
  />

  <section class="section content-section">
    <div class="container">
      <div class="page-section-heading">
        <div><p class="eyebrow eyebrow-dark"><span></span> Текущий состав</p><h2>Представители <em>всего сообщества</em></h2></div>
        <p>Состав утверждён приказом директора МБОУ СОШ № 47 от 1 сентября 2025 года № 159 на 2025–2026 учебный год.</p>
      </div>
      <div class="category-filter" aria-label="Фильтр состава">
        <button class="active" type="button" data-member-filter="all" aria-pressed="true">Все участники</button>
        <button type="button" data-member-filter="parents" aria-pressed="false">Родители</button>
        <button type="button" data-member-filter="students" aria-pressed="false">Обучающиеся</button>
        <button type="button" data-member-filter="employees" aria-pressed="false">Работники</button>
        <button type="button" data-member-filter="founder" aria-pressed="false">Представитель учредителя</button>
        <button type="button" data-member-filter="coopted" aria-pressed="false">Кооптированный член</button>
      </div>
      <div class="member-directory">
        {members.map(([category, role, name, description, featured, photo]) => (
          <article class:list={["person-card", { "person-card-featured": featured }]} data-member-category={category}>
            {photo ? (
              <img class="person-photo person-photo-image" src={`${base}${photo}`} alt={`Фотография: ${name}`} loading="lazy" />
            ) : (
              <div class="photo-placeholder person-photo">
                <span class="placeholder-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="17" r="9"></circle><path d="M8 43c1-11 7-17 16-17s15 6 16 17"></path></svg></span>
                <strong>Фотография участника УС</strong>
              </div>
            )}
            <div class="person-info"><span>{role}</span><h3>{name}</h3><p>{description}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CouncilStructureDiagram />

  <script>
    const setupMemberFilters = () => {
      const buttons = document.querySelectorAll("[data-member-filter]");
      const members = document.querySelectorAll("[data-member-category]");
      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const filter = button.getAttribute("data-member-filter") || "all";
          buttons.forEach((item) => {
            const selected = item === button;
            item.classList.toggle("active", selected);
            item.setAttribute("aria-pressed", String(selected));
          });
          members.forEach((member) => {
            const visible = filter === "all" || member.getAttribute("data-member-category") === filter;
            member.toggleAttribute("hidden", !visible);
          });
        });
      });
    };
    document.addEventListener("astro:page-load", setupMemberFilters);
  </script>
</BaseLayout>
