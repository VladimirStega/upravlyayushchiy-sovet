---
interface Props {
  title: string;
  note?: string;
  className?: string;
}

const { title, note = "", className = "" } = Astro.props;
---

<div class:list={["photo-placeholder", "content-placeholder", className]}>
  <span class="placeholder-icon">
    <svg viewBox="0 0 48 48" aria-hidden="true">
      <path d="m6 37 11-13 8 8 6-7 11 12"></path>
      <circle cx="34" cy="14" r="5"></circle>
    </svg>
  </span>
  <strong>{title}</strong>
  {note && <small>{note}</small>}
</div>
