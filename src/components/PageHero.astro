---
interface Props {
  eyebrow: string;
  title: string;
  accent: string;
  description: string;
}

const { eyebrow, title, accent, description } = Astro.props;
---

<section class="inner-hero">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <a href="/">Главная</a><span>→</span><span>{title} {accent}</span>
    </nav>
    <div class="inner-hero-grid">
      <div>
        <p class="eyebrow eyebrow-light"><span></span>{eyebrow}</p>
        <h1>{title}<br /><em>{accent}</em></h1>
      </div>
      <p>{description}</p>
    </div>
  </div>
</section>
